---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils.js';
import WebPushSubscribe from '../../../components/WebPushSubscribe.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title="Noticias | SportDharma Ecosystem" lang={lang}>
  <section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-ink mb-8">Noticias e Información</h1>
      <p class="text-lg text-ink-soft mb-8">Curación humana, 6 publicaciones diarias. Contenido fresco, verificado y relevante.</p>
      
      <WebPushSubscribe />
      
      <div class="mt-8 text-center">
        <a href={`/${lang}/rss.xml`} class="text-[#E8530E] hover:underline text-sm font-semibold">📡 Suscribirse vía RSS Feed (Open Source)</a>
      </div>
    </div>
  </section>
</Layout>
