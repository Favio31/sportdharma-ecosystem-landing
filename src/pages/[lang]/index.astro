  <style is:inline>
    .font-mono { font-family: 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace; }
    .text-gray { color: #94a3b8; }
    .text-orange { color: #E8530E; }
    .text-white { color: #ffffff; }
    .typing-text {
      display: inline;
      border-right: 2px solid #E8530E;
      padding-right: 1px;
    }
    .typing-text.blinking {
      animation: blink 0.7s step-end infinite;
    }
    @keyframes blink {
      50% { border-color: transparent; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const typingElements = Array.from(document.querySelectorAll('.typing-text'));
      const texts = typingElements.map(el => el.getAttribute('data-text'));
      const TYPE_SPEED = 35;
      const DELETE_SPEED = 20;
      const PAUSE_AFTER_TYPE = 3000;
      const PAUSE_AFTER_DELETE = 500;
      let currentLine = 0;
      let currentChar = 0;
      let isDeleting = false;

      function setActiveCursor(index) {
        typingElements.forEach((el, i) => {
          if (i === index) {
            el.classList.add('blinking');
          } else {
            el.classList.remove('blinking');
          }
        });
      }

      function tick() {
        const currentEl = typingElements[currentLine];
        const fullText = texts[currentLine];

        if (!isDeleting) {
          // Escribiendo
          currentEl.textContent = fullText.substring(0, currentChar + 1);
          currentChar++;

          if (currentChar === fullText.length) {
            // TerminÃ³ de escribir esta lÃ­nea
            if (currentLine === typingElements.length - 1) {
              // TerminÃ³ de escribir TODAS las lÃ­neas, esperar y empezar a borrar
              setActiveCursor(currentLine);
              setTimeout(() => {
                isDeleting = true;
                tick();
              }, PAUSE_AFTER_TYPE);
              return;
            } else {
              // Pasar a la siguiente lÃ­nea
              currentLine++;
              currentChar = 0;
              setActiveCursor(currentLine);
              setTimeout(tick, 150);
              return;
            }
          }
          setTimeout(tick, TYPE_SPEED);
        } else {
          // Borrando
          currentEl.textContent = fullText.substring(0, currentChar);
          currentChar--;

          if (currentChar < 0) {
            // TerminÃ³ de borrar esta lÃ­nea
            if (currentLine === 0) {
              // VolviÃ³ al inicio, reiniciar escritura
              currentChar = 0;
              isDeleting = false;
              setActiveCursor(0);
              setTimeout(tick, PAUSE_AFTER_DELETE);
              return;
            } else {
              // Borrar lÃ­nea anterior
              currentLine--;
              currentChar = texts[currentLine].length;
              setActiveCursor(currentLine);
              setTimeout(tick, DELETE_SPEED);
              return;
            }
          }
          setTimeout(tick, DELETE_SPEED);
        }
      }

      // Iniciar animaciÃ³n
      if (typingElements.length > 0) {
        setActiveCursor(0);
        setTimeout(tick, 500);
      }
    });
  </script>

