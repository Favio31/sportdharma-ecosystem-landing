---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/sections/Hero.astro';
import { useTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title="SportDharma Ecosystem | Software Libre para Deportistas Outdoor">
  <Hero />
  

  <!-- SECCIÓN DESCUBRÍ CON EFECTO TYPING -->
  <section class="py-20 px-6 bg-slate-900">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-8 text-center">
        DESCUBRÍ, ¿Qué es SportDharma Ecosystem?
      </h2>
      
      <div class="rounded-2xl overflow-hidden shadow-2xl bg-slate-950 border border-slate-800">
        <div class="flex items-center gap-2 px-4 py-3 bg-slate-800 border-b border-slate-700">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="ml-4 text-xs text-slate-400 font-mono">sportdharma.mjs</span>
        </div>
        
        <div class="p-6 md:p-8 font-mono text-sm md:text-base overflow-x-auto">
          <pre class="leading-relaxed">
<span class="text-purple-400">const</span> <span class="text-blue-400">SportDharma</span> <span class="text-slate-400">=</span> <span class="text-yellow-300">{</span>
  <span class="typing-text" data-text="infraestructura: 'libre',"></span>
  <span class="typing-text" data-text="soberania: true,"></span>
  <span class="typing-text" data-text="offline_first: true,"></span>
  <span class="typing-text" data-text="para: 'deportistas outdoor',"></span>
  <span class="typing-text" data-text="tecnologia: 'respeta tu privacidad',"></span>
  <span class="typing-text" data-text="valores: ['transparencia', 'privacidad', 'resiliencia']"></span>
<span class="text-yellow-300">};</span></pre>
        </div>
      </div>
    </div>
  </section>

  <style>
    .font-mono { font-family: 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace; }
    .typing-text { display: inline-block; overflow: hidden; border-right: 2px solid #f97316; white-space: nowrap; opacity: 0; animation: typing 2s steps(40) forwards, blink 0.7s step-end infinite; }
    .typing-text:nth-child(1) { animation-delay: 0.5s, 0.5s; }
    .typing-text:nth-child(2) { animation-delay: 1.2s, 1.2s; }
    .typing-text:nth-child(3) { animation-delay: 1.9s, 1.9s; }
    .typing-text:nth-child(4) { animation-delay: 2.6s, 2.6s; }
    .typing-text:nth-child(5) { animation-delay: 3.3s, 3.3s; }
    .typing-text:nth-child(6) { animation-delay: 4s, 4s; }
    @keyframes typing { from { width: 0; opacity: 1; } to { width: 100%; opacity: 1; } }
    @keyframes blink { 50% { border-color: transparent; } }
    .text-purple-400 { color: #c084fc; }
    .text-blue-400 { color: #60a5fa; }
    .text-yellow-300 { color: #fde047; }
    .text-slate-400 { color: #94a3b8; }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const typingElements = document.querySelectorAll('.typing-text');
      typingElements.forEach((el, index) => {
        const text = el.getAttribute('data-text');
        const delay = index * 700 + 500;
        setTimeout(() => {
          let i = 0;
          const typeInterval = setInterval(() => {
            if (i < text.length) {
              el.textContent += text.charAt(i);
              i++;
            } else {
              clearInterval(typeInterval);
            }
          }, 30);
        }, delay);
      });
    });
  </script>
  <section class="py-20 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

        <!-- 2. FUNDADOR -->
        <a href={'/' + lang + '/fundador/'} class="group block rounded-3xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
