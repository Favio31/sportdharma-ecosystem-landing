                <img src="/fundador-1.jpg" alt={t('home.fundador_alt_1')} class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
              </div>
              <div class="w-full rounded-xl border border-black/5 dark:border-white/5">
                <img src="/fundador-2.jpg" alt={t('home.fundador_alt_2')} class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
