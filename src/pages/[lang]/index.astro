          <a href={'/' + lang + '/rss/'} class="inline-block px-8 py-3 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-all">
            {t('home.rss_btn')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SUMATE AL PROYECTO -->
  <section class="py-20 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4">¿Querés contribuir o contactarnos?</h2>
      <p class="text-ink-soft mb-10 text-lg">Apoyá con tu tiempo, código o recursos. Construyamos juntos.</p>
      
      <div class="flex flex-col sm:flex-row justify-center gap-4 max-w-3xl mx-auto">
        <a href="https://liberapay.com/SportDharmaEcosystem/donate" target="_blank" rel="noopener noreferrer" class="flex-1 px-8 py-4 rounded-xl border-2 border-[#F6C915] text-[#F6C915] font-bold text-lg hover:bg-[#F6C915] hover:text-slate-900 transition-all">
          Liberapay
        </a>
        <a href="https://ko-fi.com/sportdharmaecosystem" target="_blank" rel="noopener noreferrer" class="flex-1 px-8 py-4 rounded-xl border-2 border-[#FF5E5B] text-[#FF5E5B] font-bold text-lg hover:bg-[#FF5E5B] hover:text-white transition-all">
          Ko-fi
        </a>
        <a href="https://github.com/sponsors/Favio31" target="_blank" rel="noopener noreferrer" class="flex-1 px-8 py-4 rounded-xl border-2 border-slate-400 text-slate-400 font-bold text-lg hover:bg-slate-400 hover:text-slate-900 dark:border-white dark:text-white dark:hover:bg-white dark:hover:text-slate-900 transition-all">
          GitHub Sponsor
        </a>
        <a href="https://nowpayments.io/donation/sportdharmaecosystem" target="_blank" rel="noopener noreferrer" class="flex-1 px-6 py-4 rounded-xl border-2 border-purple-500 text-purple-500 font-bold text-lg hover:bg-purple-500 hover:text-white transition-all text-center">
          Cripto
        </a>
      </div>
    </div>
  </section>

  <!-- PAGINAS AMIGAS -->
  <section class="py-16 px-6 bg-surface">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-ink mb-2">{t('home.friendly_pages.title')}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto">{t('home.friendly_pages.links').map(l=><a href={l.url} target="_blank" class="p-5 rounded-xl border hover:border-[#E8530E]/40"><span class="font-semibold">{l.name}</span></a>)}</div>
    </div>
  </section>

  <!-- REDES SOCIALES -->
  <section class="py-16 px-6 bg-surface-alt">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-ink mb-2">{t('home.social_media.title')}</h2>
      <div class="flex flex-wrap justify-center gap-4">{t('home.social_media.links').map(l=><a href={l.url} target="_blank" class="px-6 py-3 rounded-lg border hover:bg-[#E8530E] hover:text-white">{l.name}</a>)}</div>
    </div>
  </section>
</Layout>