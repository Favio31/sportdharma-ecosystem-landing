              <p class="text-ink-soft leading-relaxed text-sm text-left break-words">{t('home.fundador_desc')}</p>
            </div>
            <div class="space-y-3">
              <div class="w-full rounded-xl border-2 border-gray-300 dark:border-gray-600 ">
                <img src="/fundador-1.jpg" alt={t('home.fundador_alt_1')} class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
              </div>
              <div class="w-full rounded-xl border-2 border-gray-300 dark:border-gray-600 ">
                <img src="/fundador-2.jpg" alt={t('home.fundador_alt_2')} class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
              </div>
              <div class="w-full rounded-xl border-2 border-gray-300 dark:border-gray-600 ">
                <img src="/images/fundador/documental-un-ano-en-bicicleta.jpg" alt="Documental Un Año en Bicicleta" class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
              </div>
            </div>
          </div>
          <div class="mt-6 border-t border-black/5 pt-6 ">
            <div class="mx-auto flex w-full flex-nowrap justify-between items-start gap-1 sm:gap-4">
              <div class="min-w-0 rounded-lg border border-white/30 p-3 text-center sm:p-4">
                <div class="text-xl font-bold leading-tight text-[#E8530E] dark:text-orange-500 sm:text-2xl">120.000</div>
                <div class="mt-1 text-xs text-ink-soft">km recorridos</div>
              </div>
              <div class="min-w-0 rounded-lg border border-white/30 p-3 text-center sm:p-4">
                <div class="text-xl font-bold leading-tight text-[#E8530E] dark:text-orange-500 sm:text-2xl">84</div>
                <div class="mt-1 text-xs text-ink-soft">países</div>
              </div>
              <div class="min-w-0 rounded-lg border border-white/30 p-3 text-center sm:p-4">
                <div class="text-xl font-bold leading-tight text-[#E8530E] dark:text-orange-500 sm:text-2xl">11</div>
                <div class="mt-1 text-xs text-ink-soft">Años en ruta</div>
              </div>
            </div>
          </div>
        </a>

