---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import { useTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title="SportDharma Ecosystem | Software Libre para Deportistas Outdoor">
  <Hero />
  
  <section class="py-20 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- 2. FUNDADOR -->
        <a href="/fundador" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">FUNDADOR, SOÑADOR</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Favio M. Giorgio Data</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Cicloviajero, 120.000 kms, 84 países en 11 años. Actualmente en Luang Prabang, Laos. Certificaciones en IA, Marketing Digital y Gestión de Productos AI.</p>
        </a>

        <!-- 3. MANIFIESTO -->
        <a href="/manifiesto" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 h-full">
            <div class="flex flex-col justify-center">
              <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">MANIFIESTO</p>
              <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Así nació SportDharma Ecosystem</h3>
              <p class="text-ink-soft leading-relaxed text-sm text-justify">De los libros de la infancia a la vuelta al mundo en bicicleta. Del budismo a la IA. Una búsqueda de propósito que se transformó en infraestructura libre.</p>
            </div>
            <div class="space-y-3">
              <div class="rounded-lg overflow-hidden border border-black/5 dark:border-white/5 h-[120px]">
                <img src="/manifiesto-grupo.jpg" alt="Cicloviajeros" class="w-full h-full object-cover" draggable="false" />
              </div>
              <div class="rounded-lg overflow-hidden border border-black/5 dark:border-white/5 h-[120px]">
                <img src="/manifiesto-laos.jpg" alt="Templo en Laos" class="w-full h-full object-cover" draggable="false" />
              </div>
            </div>
          </div>
        </a>

        <!-- 4. DESCUBRÍ -->
        <a href="/ecosistema" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <div class="h-full flex flex-col">
            <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">DESCUBRÍ</p>
            <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">¿Qué es SportDharma Ecosystem?</h3>
            <p class="text-ink-soft leading-relaxed text-sm text-justify mb-4">Infraestructura libre, soberana y offline-first para deportistas outdoor. Tecnología que respeta tu privacidad y tu entorno.</p>
            <div class="rounded-xl overflow-hidden border border-black/5 dark:border-white/5 h-[180px] mt-auto">
              <img src="/masf-captura-v2.png" alt="Interfaz del sistema MASF" class="w-full h-full object-cover" draggable="false" />
            </div>
          </div>
        </a>

        <!-- 5. LOS 9 PILARES -->
        <a href="/pilares" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">LOS 9 PILARES</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Principios que nos definen</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Software Soberano, Transparente, Modular, Educación Permanente, Solidaria, Ecológica, Inclusiva, Sostenibilidad Alineada y Resiliente.</p>
        </a>

        <!-- 6. APP MÓVIL -->
        <a href="/app" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">APP MÓVIL</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Tu compañero offline en ruta</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Mapas topográficos, tracking GPS y diario de viaje. Funciona 100% sin internet, manteniendo tus datos bajo tu total control.</p>
        </a>

        <!-- 7. PÁGINA WEB -->
        <a href="/web" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">PÁGINA WEB</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Contenido curado por humanos</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Noticias, guías técnicas y recursos organizados. Instalable como PWA, multi-idioma y completamente funcional offline.</p>
        </a>

        <!-- 8. MOTOR MASF -->
        <a href="/masf" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">MOTOR MASF</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Curación humana, no algorítmica</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Arquitectura de Enjambre Multiagente. Humanos curan, IA asiste. Sin algoritmos opacos ni sesgos ocultos.</p>
        </a>

        <!-- 9. ESTADO ACTUAL DEL PROYECTO -->
        <a href="/estado" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">ESTADO ACTUAL</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Proyecto en desarrollo activo</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Fase de construcción de la infraestructura base. Preparando la aplicación al Proton Foundation Community Project con máxima calidad y seguridad.</p>
        </a>

        <!-- 10. NOTICIAS E INFORMACIÓN -->
        <a href="/noticias" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">NOTICIAS E INFORMACIÓN</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Curación humana, 6 publicaciones diarias</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Contenido fresco, verificado y relevante para la comunidad outdoor, libre de sesgos comerciales y algoritmos opacos.</p>
        </a>

        <!-- 11. EL ECOSISTEMA -->
        <a href="/herramientas" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">EL ECOSISTEMA</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Herramientas que usamos</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Astro, Tailwind CSS, Vite PWA, y arquitecturas multiagente. Stack moderno, ligero y 100% open source.</p>
        </a>

        <!-- 12. APOYA EL PROYECTO -->
        <a href="/apoya" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">APOYA EL PROYECTO</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Software libre necesita sostén</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Tu contribución mantiene la infraestructura viva, sin publicidad ni venta de datos. Grants y donaciones directas.</p>
        </a>

        <!-- 13. SUMATE AL PROYECTO -->
        <a href="/contacto" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">SUMATE AL PROYECTO</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">¿Querés contribuir o contactarnos?</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Buscamos colaboradores apasionados por el deporte, la tecnología soberana y el bienestar global. Escribinos.</p>
        </a>

        <!-- 14. COMUNIDAD Y PRESENCIA DIGITAL -->
        <a href="/comunidad" class="group block h-full rounded-2xl border border-black/5 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99] dark:border-white/5 dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40">
          <p class="text-[#E8530E] dark:text-orange-500 font-semibold text-xs uppercase tracking-wider mb-2">COMUNIDAD Y PRESENCIA</p>
          <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors">Conectá con SportDharma Ecosystem</h3>
          <p class="text-ink-soft leading-relaxed text-sm text-justify">Seguinos en nuestras plataformas digitales. Construyendo juntos una red global de deportistas conscientes.</p>
        </a>

      </div>
    </div>
  </section>
</Layout>