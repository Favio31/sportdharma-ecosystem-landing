---
import Layout from '../../layouts/Layout.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import Hero from '../../components/sections/Hero.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import NoticiasSection from '../../components/NoticiasSection.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import Extra1Card from '../../components/Extra1Card.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import CardStack from '../../components/CardStack.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import ConstructionBanner from '../../components/ConstructionBanner.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;
import { useTranslations } from '../../i18n/utils.js';
import PresenciaDigitalSection from '../../components/PresenciaDigitalSection.astro'
import TacticalHudFlyer from '../../components/TacticalHudFlyer.astro';;

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title="SportDharma Ecosystem | Software Libre para Deportistas Outdoor">
  <ConstructionBanner lang={lang} />
  <Hero />

  <section class="py-16 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

        <!-- 2. FUNDADOR -->
        <a href={'/' + lang + '/fundador/'} class="group block rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent p-8 outline-none! [-webkit-tap-highlight-color:transparent] transition-all duration-300 ease-out hover:-translate-y-1 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.35)] focus-visible:border-[#E8530E]/40 active:translate-y-0 active:scale-[0.99]  dark:hover:border-orange-500/40 dark:hover:shadow-[0_0_40px_-8px_rgba(249,115,22,0.35)] dark:focus-visible:border-orange-500/40 md:row-span-2">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex flex-col justify-center">
              <p class="text-slate-500 dark:text-slate-400 font-bold text-xs uppercase tracking-wider mb-2">{t('home.fundador_label')}</p>
