  </script>

  
  <!-- SECCIÓN DESCUBRÍ CON EFECTO TYPING -->
  <section class="py-20 px-6 bg-slate-900">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-8 text-center">
        DESCUBRÍ, ¿Qué es SportDharma Ecosystem?
      </h2>
      
      <div class="rounded-2xl overflow-hidden shadow-2xl bg-slate-950 border border-slate-800">
        <div class="flex items-center gap-2 px-4 py-3 bg-slate-800 border-b border-slate-700">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="ml-4 text-xs text-slate-400 font-mono">sportdharma.mjs</span>
        </div>
        
        <div class="p-6 md:p-8 font-mono text-sm md:text-base overflow-x-auto">
          <pre class="leading-relaxed"><span class="text-gray">const</span> <span class="text-orange">SportDharma</span> <span class="text-gray">=</span> <span class="text-white">{</span>
  <span class="text-orange">infraestructura:</span> <span class="typing-text" data-text="'libre',"></span>
  <span class="text-orange">soberania:</span> <span class="typing-text" data-text="true,"></span>
  <span class="text-orange">offline_first:</span> <span class="typing-text" data-text="true,"></span>
  <span class="text-orange">para:</span> <span class="typing-text" data-text="'deportistas outdoor',"></span>
  <span class="text-orange">tecnologia:</span> <span class="typing-text" data-text="'respeta tu privacidad',"></span>
  <span class="text-orange">valores:</span> <span class="typing-text" data-text="['transparencia', 'privacidad', 'resiliencia']"></span>
<span class="text-white">};</span></pre>
        </div>
      </div>
    </div>
  </section>

  <style>
    .font-mono { font-family: 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace; }
    .text-gray { color: #94a3b8; }
    .text-orange { color: #E8530E; }
    .text-white { color: #ffffff; }
    .typing-text { display: inline-block; overflow: hidden; border-right: 2px solid #E8530E; white-space: nowrap; opacity: 0; animation: typing 1.5s steps(40) forwards, blink 0.7s step-end infinite; }
    .typing-text:nth-child(1) { animation-delay: 0.5s, 0.5s; }
    .typing-text:nth-child(2) { animation-delay: 1.2s, 1.2s; }
    .typing-text:nth-child(3) { animation-delay: 1.9s, 1.9s; }
    .typing-text:nth-child(4) { animation-delay: 2.6s, 2.6s; }
    .typing-text:nth-child(5) { animation-delay: 3.3s, 3.3s; }
    .typing-text:nth-child(6) { animation-delay: 4s, 4s; }
    @keyframes typing { from { width: 0; opacity: 1; } to { width: 100%; opacity: 1; } }
    @keyframes blink { 50% { border-color: transparent; } }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const typingElements = document.querySelectorAll('.typing-text');
      typingElements.forEach((el, index) => {
        const text = el.getAttribute('data-text');
        const delay = index * 700 + 500;
        setTimeout(() => {
          let i = 0;
          const typeInterval = setInterval(() => {
            if (i < text.length) {
              el.textContent += text.charAt(i);
