---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title={t('home.hero_title') + ' | SportDharma Ecosystem'} lang={lang}>
  <!-- HERO SECTION -->
  <section class="relative min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))]"></div>
    </div>
    
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-32 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#E8530E]/10 border border-[#E8530E]/20 mb-8">
        <span class="w-2 h-2 rounded-full bg-[#E8530E] animate-pulse"></span>
        <span class="text-[#E8530E] font-semibold text-sm">Software libre · Local-first · Privacidad total</span>
      </div>
      
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        Infraestructura libre para<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#E8530E] to-orange-400">quienes viven en libertad</span>
      </h1>
      
      <p class="text-xl text-slate-300 mb-10 max-w-3xl mx-auto leading-relaxed">
        Nueve pilares. Arquitectura soberana. Resiliencia outdoor. Un ecosistema abierto para deportistas, equipos de primera respuesta, comunidades aisladas y territorios sin conectividad.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/#ecosistema`} class="px-8 py-4 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-all hover:scale-105 shadow-lg shadow-[#E8530E]/25">
          Descubrir el ecosistema
        </a>
        <a href={`/${lang}/#pilares`} class="px-8 py-4 rounded-lg border border-white/20 text-white font-semibold hover:bg-white/10 transition-all">
          Ver los 9 pilares
        </a>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE SUSCRIPCIÓN -->
  <section class="py-20 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-ink mb-4">{t('home.mantenete_al_dia')}</h2>
      <p class="text-ink-soft text-lg mb-10">{t('home.mantenete_desc')}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Web Push -->
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-transparent text-center">
          <h3 class="text-xl font-bold text-ink mb-2">🔔 Recibí avisos de nuevo contenido</h3>
          <p class="text-ink-soft text-sm mb-4">Sin emails, sin registro, sin tracking. Solo notificaciones nativas del navegador.</p>
          <a href={`/${lang}/noticias/`} class="inline-block px-6 py-2 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-colors">
            Activar Notificaciones
          </a>
        </div>
        
        <!-- RSS Feed -->
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-transparent text-center">
          <h3 class="text-xl font-bold text-ink mb-2"> RSS Feed (Open Source)</h3>
          <p class="text-ink-soft text-sm mb-4">Copiá la URL en tu lector RSS favorito (Feedly, Inoreader, NetNewsWire).</p>
          <a href={`/${lang}/rss/`} class="inline-block px-6 py-2 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-colors">
            Ver Feed RSS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PILARES -->
  <section id="pilares" class="py-20 px-6 bg-surface transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-ink mb-12 text-center">Los 9 Pilares</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Software Soberano</h3>
          <p class="text-ink-soft">Código abierto, auditado y bajo tu control total.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Transparente</h3>
          <p class="text-ink-soft">Sin algoritmos opacos ni sesgos ocultos.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Modular</h3>
          <p class="text-ink-soft">Arquitectura flexible y adaptable.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Educación Permanente</h3>
          <p class="text-ink-soft">Formación continua y accesible.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Solidaria</h3>
          <p class="text-ink-soft">Tecnología al servicio de comunidades.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Ecológica</h3>
          <p class="text-ink-soft">Bajo impacto ambiental y energética.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Inclusiva</h3>
          <p class="text-ink-soft">Accesible para todos, sin barreras.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Sostenible</h3>
          <p class="text-ink-soft">Modelo económico alineado con valores.</p>
        </div>
        <div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-xl font-bold text-[#E8530E] mb-2">Resiliente</h3>
          <p class="text-ink-soft">Funciona offline y en entornos extremos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ECOSISTEMA -->
  <section id="ecosistema" class="py-20 px-6 bg-surface-alt transition-colors duration-300">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-ink mb-12 text-center">El Ecosistema</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-2xl font-bold text-ink mb-4">App Móvil</h3>
          <p class="text-ink-soft mb-4">Tu compañero offline en ruta. Mapas topográficos, tracking GPS y diario de viaje.</p>
          <a href={`/${lang}/app/`} class="text-[#E8530E] font-semibold hover:underline">Más información →</a>
        </div>
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-2xl font-bold text-ink mb-4">Página Web</h3>
          <p class="text-ink-soft mb-4">Contenido curado por humanos. Instalable como PWA, multi-idioma y offline.</p>
          <a href={`/${lang}/web/`} class="text-[#E8530E] font-semibold hover:underline">Más información →</a>
        </div>
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-2xl font-bold text-ink mb-4">Motor MASF</h3>
          <p class="text-ink-soft mb-4">Curación humana, no algorítmica. Arquitectura de Enjambre Multiagente.</p>
          <a href={`/${lang}/masf/`} class="text-[#E8530E] font-semibold hover:underline">Más información →</a>
        </div>
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface hover:border-[#E8530E]/40 transition-all">
          <h3 class="text-2xl font-bold text-ink mb-4">Herramientas</h3>
          <p class="text-ink-soft mb-4">Astro, Tailwind CSS, Vite PWA. Stack moderno, ligero y 100% open source.</p>
          <a href={`/${lang}/herramientas/`} class="text-[#E8530E] font-semibold hover:underline">Más información →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-20 px-6 bg-gradient-to-br from-[#E8530E] to-orange-600 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Sumate al proyecto</h2>
      <p class="text-xl mb-8 opacity-90">Software libre necesita sostén. Tu contribución mantiene la infraestructura viva.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`/${lang}/apoya/`} class="px-8 py-4 rounded-lg bg-white text-[#E8530E] font-semibold hover:bg-slate-100 transition-colors">
          Apoyar el proyecto
        </a>
        <a href={`/${lang}/contacto/`} class="px-8 py-4 rounded-lg border border-white text-white font-semibold hover:bg-white/10 transition-colors">
          Contactarnos
        </a>
      </div>
    </div>
  </section>
</Layout>