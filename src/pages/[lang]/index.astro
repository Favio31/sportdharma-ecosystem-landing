<span class="text-[#38bdf8]">infraestructura:</span> <span class="cs-tw"><span class="cs-ghost">'libre',</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="text-[#38bdf8]">soberania:</span> <span class="cs-tw"><span class="cs-ghost">true,</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="text-[#38bdf8]">offline_first:</span> <span class="cs-tw"><span class="cs-ghost">true,</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="text-[#38bdf8]">para:</span> <span class="cs-tw"><span class="cs-ghost">'deportistas outdoor', rescatistas, comunidades remotas</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="text-[#38bdf8]">tecnologia:</span> <span class="cs-tw"><span class="cs-ghost">'respeta tu privacidad',</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="text-[#38bdf8]">valores:</span> <span class="cs-tw"><span class="cs-ghost">['transparencia', 'privacidad', 'resiliencia']</span><span class="cs-live" aria-hidden="true"></span></span>
<span class="col-span-2 text-[#a78bfa]">};</span></pre>
        </div>
      </div>
      <div class="flex items-center justify-center">
        <TacticalHudFlyer />
      </div>
    </a>
  </div>
</section>

<!-- RESTO DE TARJETAS -->
  <section class="py-16 px-6 bg-surface-alt transition-colors duration-300">
