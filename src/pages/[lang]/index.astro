              <div class="w-full rounded-xl border-2 border-gray-300 dark:border-gray-600 ">
                <img src="/logo-social2.jpg" alt="SportDharma Ecosystem Logo" class="w-full h-auto rounded-xl border border-white/30" draggable="false" />
              </div>
            </div>
          </div>
        </a>

        <!-- EXTRA 1 (debajo de Manifiesto) -->
        <Extra1Card />

  <!-- INFRAESTRUCTURA TÉCNICA -->
</div>
    </div>
