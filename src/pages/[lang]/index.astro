        <div class="flex items-center gap-2 px-3 md:px-4 py-2 bg-surface-alt border-b border-gray-500">
          <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[#fde047]"></div>
          <div class="w-2.5 h-2.5 md:w-3 md:h-3 rounded-full bg-[#fde047]"></div>
