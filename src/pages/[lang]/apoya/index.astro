---
import Layout from '../../../layouts/Layout.astro';
export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
  ];
}
const { lang } = Astro.params;
---
<Layout title="Apoya | SportDharma Ecosystem">
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div class="text-6xl mb-6">🤝</div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4">Apoyá el proyecto</h1>
        <p class="text-xl text-ink-soft">SportDharma es software libre. Tu apoyo mantiene la infraestructura viva.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt">
          <div class="text-4xl mb-4"></div>
          <h3 class="text-2xl font-bold text-ink mb-3">Donación directa</h3>
          <p class="text-ink-soft mb-6">Contribución única o recurrente para mantener servidores, dominios y desarrollo.</p>
          <a href="mailto:favio@sportdharmaecosystem.com" class="inline-block px-6 py-3 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-all">
            Contactar para donar
          </a>
        </div>
        
        <div class="p-8 rounded-2xl border border-black/5 dark:border-white/5 bg-surface-alt">
          <div class="text-4xl mb-4">🏛️</div>
          <h3 class="text-2xl font-bold text-ink mb-3">Grants y fondos</h3>
          <p class="text-ink-soft mb-6">Si representás una organización, fundación o programa de grants de software libre.</p>
          <a href="mailto:favio@sportdharmaecosystem.com?subject=Grant%20Proposal" class="inline-block px-6 py-3 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-all">
            Proponer grant
          </a>
        </div>
      </div>
      
      <div class="p-8 rounded-2xl border-2 border-[#E8530E]/30 bg-surface-alt text-center">
        <h3 class="text-2xl font-bold text-ink mb-4">¿Querés contribuir con código o contenido?</h3>
        <p class="text-ink-soft mb-6">Buscamos colaboradores apasionados por el deporte, la tecnología soberana y el bienestar global.</p>
        <a href="/contacto/" class="inline-block px-8 py-3 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-all">
          Sumate al equipo
        </a>
      </div>
    </div>
  </section>
</Layout>