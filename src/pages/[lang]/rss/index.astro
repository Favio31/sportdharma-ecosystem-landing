---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils.js';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title={t('rss.page_title') + ' | SportDharma Ecosystem'} lang={lang}>
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div class="text-7xl mb-6">📡</div>
        <h1 class="text-5xl font-bold text-ink mb-4">{t('rss.titulo')}</h1>
        <p class="text-2xl text-ink-soft mb-8">{t('rss.subtitulo')}</p>
      </div>
      
      <div class="prose prose-lg dark:prose-invert max-w-none mb-12">
        <p class="text-ink-soft text-center text-lg leading-relaxed">
          {t('rss.descripcion')}
        </p>
      </div>
      
      <!-- Caja con la URL del RSS -->
      <div class="bg-surface-alt border-2 border-[#E8530E]/30 rounded-2xl p-8 mb-10">
        <h2 class="text-2xl font-bold text-ink mb-4 text-center">{t('rss.url_titulo')}</h2>
        <div class="bg-black/5 dark:bg-white/5 rounded-lg p-4 mb-4">
          <code class="text-[#E8530E] text-sm break-all select-all block text-center font-mono">
            https://www.sportdharmaecosystem.com/rss.xml
          </code>
        </div>
        <p class="text-ink-soft text-sm text-center">{t('rss.url_instruccion')}</p>
      </div>
      
      <!-- Lectores recomendados -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt">
          <h3 class="font-bold text-ink mb-2">Feedly</h3>
          <p class="text-ink-soft text-sm">El lector RSS más popular. Gratis y multiplataforma.</p>
          <a href="https://feedly.com" target="_blank" rel="noopener" class="text-[#E8530E] text-sm font-semibold hover:underline mt-2 inline-block">Visitar →</a>
        </div>
        <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt">
          <h3 class="font-bold text-ink mb-2">Inoreader</h3>
          <p class="text-ink-soft text-sm">Potente y con funciones avanzadas de filtrado.</p>
          <a href="https://inoreader.com" target="_blank" rel="noopener" class="text-[#E8530E] text-sm font-semibold hover:underline mt-2 inline-block">Visitar →</a>
        </div>
        <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt">
          <h3 class="font-bold text-ink mb-2">NetNewsWire</h3>
          <p class="text-ink-soft text-sm">Open source para macOS e iOS. Rápido y ligero.</p>
          <a href="https://netnewswire.com" target="_blank" rel="noopener" class="text-[#E8530E] text-sm font-semibold hover:underline mt-2 inline-block">Visitar →</a>
        </div>
      </div>
      
      <!-- Botones de acción -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/rss.xml" target="_blank" rel="noopener" class="px-8 py-4 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-all hover:scale-105 text-center">
          {t('rss.ver_xml')}
        </a>
        <a href={/\/} class="px-8 py-4 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-all text-center">
          {t('rss.volver_home')}
        </a>
      </div>
      
      <!-- Info adicional -->
      <div class="mt-12 p-6 rounded-xl bg-[#E8530E]/10 border border-[#E8530E]/20">
        <h3 class="font-bold text-ink mb-3">¿Qué es RSS?</h3>
        <p class="text-ink-soft text-sm leading-relaxed">
          RSS (Really Simple Syndication) es un formato estandarizado y abierto para distribuir contenido web de forma descentralizada. 
          Sin algoritmos, sin tracking, sin intermediarios. Vos controlás qué leer y cuándo.
        </p>
      </div>
    </div>
  </section>
</Layout>