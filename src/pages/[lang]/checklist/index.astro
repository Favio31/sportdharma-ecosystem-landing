---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;

const fullList = [
  { id: 'bike', title: '1. Revisión de la bicicleta', desc: 'Frenos, presión de cubiertas, cadena lubricada y ajuste de cambios. Una bici segura es tu principal aliada.' },
  { id: 'gear', title: '2. Revisión del equipamiento', desc: 'Alforjas bien sujetas, kit de reparación, cámara de repuesto, documentación y agua suficiente para la etapa.' },
  { id: 'warmup', title: '3. Calentamiento', desc: '10 minutos de movilidad articular y estiramientos dinámicos. Prepara tus músculos y previene lesiones en ruta.' },
  { id: 'quote', title: '4. Frase del día', desc: 'Conecta con tu propósito. Lee una reflexión, un verso o un pensamiento que guíe tu estado mental durante el pedaleo.' },
  { id: 'map', title: '5. Abrir OpenStreetMap', desc: 'Descarga la zona de hoy. Verifica la ruta, los puntos de agua y los posibles refugios. Navegación 100% offline y soberana.' },
  { id: 'weather', title: '6. App de clima', desc: 'Revisá el pronóstico de las próximas 6 horas. Anticipate al viento, la lluvia o el calor extremo para ajustar tu ritmo.' },
  { id: 'health', title: '7. Cuidado físico', desc: 'Hidratación antes de salir. Proteger la piel del sol. Escuchar a tu cuerpo: si hay dolor agudo, es momento de parar.' }
];
---
<Layout lang={lang} title="Lista de Verificación | SportDharma">
  <main class="min-h-screen bg-gradient-to-b from-[#2C1810] to-[#1a0f0a] py-20 px-4 md:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Antes de Pedalear</h1>
        <p class="text-amber-200/80 text-lg">Marcá cada ítem a medida que lo completás. Tu navegador guardará tu progreso localmente.</p>
      </div>

      <div class="space-y-4">
        {fullList.map((item) => (
          <label class="flex items-start gap-4 p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all cursor-pointer group">
            <input type="checkbox" id={item.id} class="checklist-item mt-1 w-5 h-5 rounded border-gray-500 text-amber-500 focus:ring-amber-500 bg-transparent" />
            <div>
              <h3 class="text-xl font-bold text-white mb-1 group-hover:text-amber-300 transition-colors">{item.title}</h3>
              <p class="text-amber-100/70 leading-relaxed">{item.desc}</p>
            </div>
          </label>
        ))}
      </div>

      <div class="mt-12 text-center">
        <button id="resetBtn" class="text-sm text-amber-400 hover:text-amber-300 underline transition-colors">Reiniciar lista para mañana</button>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const checkboxes = document.querySelectorAll('.checklist-item');
      checkboxes.forEach(cb => {
        const id = cb.id;
        if (localStorage.getItem('sde_checklist_' + id) === 'true') cb.checked = true;
        cb.addEventListener('change', (e) => {
          localStorage.setItem('sde_checklist_' + id, e.target.checked);
        });
      });

      const resetBtn = document.getElementById('resetBtn');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if(confirm('¿Reiniciar la lista para un nuevo día?')) {
            checkboxes.forEach(cb => {
              cb.checked = false;
              localStorage.removeItem('sde_checklist_' + cb.id);
            });
          }
        });
      }
    });
  </script>
</Layout>