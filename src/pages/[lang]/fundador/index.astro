---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils.js';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title={t('fundador.page_title')}>
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div class="w-32 h-32 mx-auto mb-6 rounded-full bg-[#E8530E]/10 flex items-center justify-center text-6xl"></div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4">Favio</h1>
        <p class="text-xl text-[#E8530E] font-semibold">{t('fundador.subtitle')}</p>
      </div>
      
      <div class="prose prose-lg dark:prose-invert max-w-none space-y-6 text-ink-soft">
        <p class="text-lg leading-relaxed" set:html={t('fundador.bio_p1')}></p>
        <p class="text-lg leading-relaxed" set:html={t('fundador.bio_p2')}></p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-12">
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">120.000</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_km_label')}</div>
          </div>
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">84</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_countries_label')}</div>
          </div>
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">11</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_years_label')}</div>
          </div>
        </div>
        
        <p class="text-lg leading-relaxed">{t('fundador.bio_p3')}</p>
      </div>
    </div>
  </section>
</Layout>