---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils.js';
import RedesSocialesSection from '../../../components/RedesSocialesSection.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---

<Layout title={t('fundador.page_title')}>
  <section class="py-20 px-6 bg-surface">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
                <div class="flex flex-wrap justify-center items-center gap-6 mb-6">
          <img
            src="/images/fundador/suenos-a-pedal.jpg"
            alt="Sueños A Pedal Logo"
            class="w-48 h-48 rounded-2xl object-cover shadow-lg bg-white"
          />
          <a href="https://www.facebook.com/PedalearElMundo/" target="_blank" rel="noopener noreferrer" title="Pedalear el Mundo en Facebook" class="block">
            <img
              src="/fundador/fb-pedalear.jpg"
              alt="Pedalear el Mundo Logo"
              class="w-48 h-48 rounded-2xl object-cover shadow-lg bg-white transition-all duration-300"
            />
          </a>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4">{t('fundador.title')}</h1>
        <p class="text-xl text-[#E8530E] font-semibold italic">{t('fundador.tagline')}</p>
      </div>
      
      <div class="prose prose-lg dark:prose-invert max-w-none space-y-6 text-ink-soft text-left">
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p1')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p2')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p3')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p4')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p5')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p6')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p7')}></p>
        <p class="text-lg leading-relaxed text-left" set:html={t('fundador.p8')}></p>
        
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-12">
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">120.000</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_km_label')}</div>
          </div>
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">84</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_countries_label')}</div>
          </div>
          <div class="p-6 rounded-xl border border-black/5 dark:border-white/5 bg-surface-alt text-center">
            <div class="text-3xl font-bold text-[#E8530E]">11</div>
            <div class="text-sm text-ink-soft mt-1">{t('fundador.stat_years_label')}</div>
          </div>
        </div>
        
        <!-- Galería bento grid 8 fotos -->
        <div class="my-12">
          <h2 class="text-2xl font-bold text-center text-ink mb-6">{t('fundador.gallery_title')}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4 auto-rows-[150px] sm:auto-rows-[180px] md:auto-rows-[200px] md:[grid-template-areas:'a_a_b_b'_'a_a_b_b'_'c_c_d_e'_'c_c_f_f'_'g_h_f_f']">
            <!-- Foto 1: Arriba izquierda (2×2) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-2 md:[grid-area:a]">
              <img src="/images/fundador/foto-1.jpg" 
                alt={t('fundador.photo1_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 2: Arriba derecha (2×2) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-2 md:[grid-area:b]">
              <img src="/images/fundador/foto-2.jpg" 
                alt={t('fundador.photo2_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 3: Medio izquierda vertical (2×2) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-2 md:[grid-area:c]">
              <img src="/images/fundador/foto-3.jpg" 
                alt={t('fundador.photo3_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 4: Medio derecha arriba pequeña (1×1) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-1 md:[grid-area:d]">
              <img src="/images/fundador/foto-4.jpg" 
                alt={t('fundador.photo4_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 5: Medio derecha arriba pequeña (1×1) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-1 md:[grid-area:e]">
              <img src="/images/fundador/foto-5.jpg" 
                alt={t('fundador.photo5_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 6: Medio derecha abajo grande (2×2) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-2 md:[grid-area:f]">
              <img src="/images/fundador/foto-6.jpeg" 
                alt={t('fundador.photo6_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 7: Abajo izquierda pequeña (1×1) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-1 md:[grid-area:g]">
              <img src="/images/fundador/foto-7.jpg" 
                alt={t('fundador.photo7_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
            <!-- Foto 8: Abajo izquierda pequeña (1×1) -->
            <div class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow duration-300 col-span-1 md:[grid-area:h]">
              <img src="/images/fundador/foto-8.jpeg" 
                alt={t('fundador.photo8_alt')}
                class="w-full h-full object-cover rounded-xl"
                loading="lazy"
              />
            </div>
          </div>
        <p class="text-center text-xs text-slate-500 dark:text-slate-400 italic mt-6">FOTOS: Marcelo Curia, Marcelo Lezcano y Favio M. Giorgio.</p>
        </div>
        
        <!-- CTA -->
        <div class="mt-12 text-center">
          <RedesSocialesSection />

<a href={'/' + lang + '/#notificaciones'} class="inline-block bg-[#E8530E] hover:bg-orange-600 text-white font-semibold py-4 px-10 rounded-lg transition-colors duration-300 shadow-lg hover:shadow-xl text-lg">
            {t('fundador.cta')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>