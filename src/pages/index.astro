---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ManifiestoCard from '../components/cards/ManifiestoCard.astro';
import QueEsSection from '../components/sections/QueEsSection.astro';
import PilaresSection from '../components/sections/PilaresSection.astro';
import AppCard from '../components/cards/AppCard.astro';
import WebCard from '../components/cards/WebCard.astro';
import MASFCard from '../components/cards/MASFCard.astro';
import NoticiasSection from '../components/NoticiasSection.astro';
import EcosistemaSection from '../components/EcosistemaSection.astro';
import ApoyoSection from '../components/ApoyoSection.astro';
import ContactoSection from '../components/ContactoSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import PrivacyNote from '../components/PrivacyNote.astro';
---

<Layout title="SportDharma Ecosystem | Software Libre para Deportistas Outdoor">
  <Hero />
  <ManifiestoCard />
  <QueEsSection />
  <PilaresSection />
  <AppCard />
  <WebCard />
  <MASFCard />
  <NoticiasSection />
  <EcosistemaSection />
  <ApoyoSection />
  <ContactoSection />
  <CommunitySection />
  <div class="max-w-6xl mx-auto px-6 py-16">
    <PrivacyNote />
  </div>
</Layout>
