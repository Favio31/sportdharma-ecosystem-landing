---
import LanguageSelector from '../components/LanguageSelector.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/Footer.astro';
import SWRegister from '../components/SWRegister.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ? Astro.site.href : 'https://sportdharmaecosystem.com');

interface Props { 
  title: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const { 
  title, 
  description = "SportDharma Ecosystem: Software libre, local-first y privacidad total para deportistas outdoor y comunidades.",
  ogImage = "https://sportdharmaecosystem.com/logo-social.jpg?v=10",
  ogTitle = title,
  ogDescription = description
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />

    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="SportDharma Ecosystem" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100 flex flex-col min-h-screen transition-colors duration-300">
    <Header lang={Astro.params.lang}  lang={Astro.params.lang} />
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-end">
      <LanguageSelector {lang} />
    </div>
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SWRegister />
  </body>
</html>