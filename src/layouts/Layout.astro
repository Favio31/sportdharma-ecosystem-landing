---
import LanguageSelector from '../components/LanguageSelector.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ? Astro.site.href : 'https://www.sportdharmaecosystem.com');
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/Footer.astro';
import SWRegister from '../components/SWRegister.astro';

interface Props { 
  title: string; 
}

const { title } = Astro.props;
---
const canonical = new URL(Astro.url.pathname, Astro.site ? Astro.site.href : 'https://www.sportdharmaecosystem.com');

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content="SportDharma Ecosystem: Software libre, local-first y privacidad total para deportistas outdoor y comunidades." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />

    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme') || 'system';
        var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
          <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.sportdharmaecosystem.com/" />
    <meta property="og:title" content="SportDharma Ecosystem" />
    <meta property="og:description" content="Infraestructura libre, soberana y offline-first para deportistas outdoor." />
    <meta property="og:image" content="https://www.sportdharmaecosystem.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="SportDharma Ecosystem" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="SportDharma Ecosystem" />
    <meta name="twitter:description" content="Infraestructura libre, soberana y offline-first para deportistas outdoor." />
    <meta name="twitter:image" content="https://www.sportdharmaecosystem.com/og-image.png" />
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100 flex flex-col min-h-screen transition-colors duration-300">
    <Header />
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-end">
      <LanguageSelector {lang} />
    </div>
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SWRegister />
  </body>
</html>








