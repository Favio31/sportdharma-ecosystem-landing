---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SWRegister from '../components/SWRegister.astro';

interface Props { 
  title: string; 
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href="https://www.sportdharmaecosystem.com/" />
    
    <!-- PRUEBA NUCLEAR: CSS puro, sin Tailwind, con !important -->
    <style is:global>
      html.dark body {
        background-color: #ff0000 !important; /* ROJO PURO PARA PROBAR */
        color: #ffffff !important;
      }
      html.dark main, 
      html.dark header, 
      html.dark footer,
      html.dark div,
      html.dark section {
        background-color: #ff0000 !important;
        color: #ffffff !important;
      }
    </style>

    <script is:inline>
      console.log('🚀 SCRIPT NUCLEAR EJECUTÁNDOSE');
      const t = localStorage.getItem('theme') || 'system';
      const dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) {
        document.documentElement.classList.add('dark');
        console.log('✅ CLASE .dark AGREGADA AL HTML');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white text-slate-900 flex flex-col min-h-screen">
    
    <!-- CARTEL DE PRUEBA: Si ves esto, el código nuevo SÍ se desplegó -->
    <div style="position: fixed; top: 0; left: 0; width: 100%; background: #ffff00; color: #000; text-align: center; padding: 15px; z-index: 99999; font-weight: bold; font-size: 18px; border-bottom: 3px solid #000;">
      ⚠️ PRUEBA: SI VES ESTO, EL CÓDIGO SE ACTUALIZÓ CORRECTAMENTE ⚠️
    </div>

    <Header />
    <main class="flex-grow pt-16">
      <slot />
    </main>
    <Footer />
    <SWRegister />
  </body>
</html>