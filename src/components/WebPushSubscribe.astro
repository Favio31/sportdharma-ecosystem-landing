---
// src/components/WebPushSubscribe.astro
---

<div class="push-subscribe-container">
  <h3>Notificaciones Soberanas</h3>
  <p>Recibí actualizaciones sin dejar tu correo electrónico.</p>
  <button id="subscribe-push" class="subscribe-btn">
    🔔 Activar Notificaciones
  </button>
  <button id="force-unsubscribe" class="unsubscribe-btn" style="display:none;">
    🗑️ Limpiar y Reinstalar
  </button>
  <p id="push-status"></p>
</div>

<script>
  const VAPID_PUBLIC_KEY = 'BJG7t66S2zcnY5DtjjEJ6X18RhmpWtKCdlwwszKrAn4tnuNGOGPzIqySXz6hvYl6cfU2AcjY6wiUny8xN-Cd8Y4';

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  // Función para forzar desuscripción total
  async function forceUnsubscribe() {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;
    
    try {
      // 1. Obtener todos los Service Workers
      const registrations = await navigator.serviceWorker.getRegistrations();
      
      // 2. Eliminar todos los Service Workers
      for (let registration of registrations) {
        const subscription = await registration.pushManager.getSubscription();
        if (subscription) {
          await subscription.unsubscribe();
          console.log('✅ Suscripción eliminada');
        }
        await registration.unregister();
        console.log('✅ Service Worker desregistrado');
      }
      
      // 3. Limpiar caché
      const caches = await caches.keys();
      await Promise.all(caches.map(cache => cache.delete()));
      
      statusEl.textContent = '✅ Limpieza completada. Ahora podés activar notificaciones.';
      statusEl.style.color = '#10b981';
      
      // Mostrar botón de activar
      document.getElementById('subscribe-push').style.display = 'inline-block';
      document.getElementById('force-unsubscribe').style.display = 'none';
      
    } catch (error) {
      console.error('Error:', error);
      statusEl.textContent = '❌ Error al limpiar: ' + error.message;
    }
  }

  // Función para activar notificaciones
  async function subscribeToPush() {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;

    try {
      // Verificar soporte
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        statusEl.textContent = '❌ Navegador no soportado.';
        return;
      }

      // 1. Registrar Service Worker
      const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
      console.log('✅ Service Worker registrado:', registration);

      // 2. Solicitar permiso
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        statusEl.textContent = '❌ Permiso denegado.';
        return;
      }

      // 3. Verificar si hay suscripción vieja
      const existingSubscription = await registration.pushManager.getSubscription();
      if (existingSubscription) {
        console.log('⚠️ Ya existe una suscripción, eliminando...');
        await existingSubscription.unsubscribe();
      }

      // 4. Crear nueva suscripción
      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });

      // 5. Enviar al Worker
      const response = await fetch('https://sportdharmapush.faviosuenosapedat.workers.dev/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(subscription)
      });

      const responseText = await response.text();
      if (response.ok) {
        statusEl.textContent = '✅ ¡Notificaciones activadas!';
        statusEl.style.color = '#10b981';
      } else {
        statusEl.textContent = '❌ Error: ' + responseText;
        statusEl.style.color = '#ef4444';
      }
    } catch (error) {
      console.error('Error:', error);
      statusEl.textContent = '❌ Error: ' + error.message;
      statusEl.style.color = '#ef4444';
      
      // Si el error es de clave diferente, mostrar botón de limpieza
      if (error.message.includes('applicationServerKey') || error.message.includes('gcm_sender_id')) {
        statusEl.textContent = '❌ Conflicto de claves. Presioná "Limpiar y Reinstalar"';
        document.getElementById('force-unsubscribe').style.display = 'inline-block';
      }
    }
  }

  // Event listeners
  document.getElementById('subscribe-push')?.addEventListener('click', subscribeToPush);
  document.getElementById('force-unsubscribe')?.addEventListener('click', forceUnsubscribe);

  // Verificar al cargar si hay conflicto
  window.addEventListener('load', async () => {
    try {
      const registration = await navigator.serviceWorker.getRegistration();
      if (registration) {
        const subscription = await registration.pushManager.getSubscription();
        if (subscription) {
          const keys = subscription.toJSON().keys;
          if (keys && keys.p256dh && keys.auth) {
            console.log('✅ Ya hay una suscripción activa');
          }
        }
      }
    } catch (error) {
      console.error('Error al verificar:', error);
    }
  });
</script>

<style>
  .push-subscribe-container {
    text-align: center;
  }
  .subscribe-btn {
    background: #E8530E;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    display: inline-block;
  }
  .subscribe-btn:hover {
    background: #d14a0c;
    transform: translateY(-2px);
  }
  .unsubscribe-btn {
    background: #dc2626;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
    display: none;
  }
  .unsubscribe-btn:hover {
    background: #b91c1c;
  }
  #push-status {
    margin-top: 1rem;
    font-size: 14px;
    min-height: 1.5rem;
  }
</style>