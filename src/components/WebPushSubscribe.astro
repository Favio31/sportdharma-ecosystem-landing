<!-- Componente de Notificaciones Push (100% privado, sin emails) -->
<div class="p-8 rounded-3xl border border-black/5 dark:border-white/5 bg-transparent hover:border-[#E8530E]/40 transition-all flex flex-col justify-between h-full">
  <div>
    <div class="text-5xl mb-4">🔔</div>
    <h3 class="text-2xl font-bold text-ink mb-3">Notificaciones Soberanas</h3>
    <p class="text-ink-soft mb-6 text-sm leading-relaxed">
      Recibí actualizaciones <strong>sin dejar tu correo electrónico</strong>. 
      Usamos tecnología nativa del navegador: <strong>sin bases de datos, sin tracking y sin spam</strong>. 
      Tenés el control absoluto para desactivarlo cuando quieras.
    </p>
  </div>
  <div>
    <button id="subscribe-push" class="w-full px-8 py-3 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-all hover:scale-105 flex items-center justify-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      Activar Notificaciones
    </button>
    <p id="push-status" class="text-xs text-ink-soft mt-3 text-center min-h-[1.25rem]"></p>
  </div>
</div>

<script is:inline>
  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  function waitForServiceWorker(timeout = 10000) {
    return new Promise((resolve, reject) => {
      if (navigator.serviceWorker.controller) {
        resolve(navigator.serviceWorker);
        return;
      }
      const timer = setTimeout(() => reject(new Error('Timeout: SW no se registró')), timeout);
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        clearTimeout(timer);
        resolve(navigator.serviceWorker);
      });
      navigator.serviceWorker.register('/sw.js', { scope: '/' })
        .then(reg => {
          console.log('[Push] SW registrado:', reg.scope);
          if (reg.active) {
            clearTimeout(timer);
            resolve(navigator.serviceWorker);
          }
        })
        .catch(err => {
          clearTimeout(timer);
          reject(err);
        });
    });
  }

  document.getElementById('subscribe-push')?.addEventListener('click', async () => {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;

    if (!('serviceWorker' in navigator)) {
      statusEl.textContent = '❌ Tu navegador no soporta Service Workers.';
      return;
    }
    if (!('PushManager' in window)) {
      statusEl.textContent = '❌ Tu navegador no soporta Push.';
      return;
    }

    try {
      statusEl.textContent = '1/4 Registrando Service Worker...';
      await waitForServiceWorker(10000);
      const registration = await navigator.serviceWorker.ready;
      console.log('[Push] SW ready:', registration.scope);

      statusEl.textContent = '2/4 Solicitando permiso...';
      const permission = await Notification.requestPermission();
      console.log('[Push] Permiso:', permission);
      
      if (permission !== 'granted') {
        statusEl.textContent = '❌ Permiso denegado. Actívalo en tu navegador.';
        return;
      }

      statusEl.textContent = '3/4 Generando suscripción...';
      const vapidPublicKey = 'BEjsqpP02JpqiGtPi8bEfparA7Ng7SlkklYzXm6RhLF1SZwvaorc5jcm5QDt0htWiHGEecywWPvC4_hwJRelwQk';
      
      let applicationServerKey;
      try {
        applicationServerKey = urlBase64ToUint8Array(vapidPublicKey);
      } catch (e) {
        statusEl.textContent = '❌ Clave VAPID inválida.';
        console.error('[Push] Error en clave VAPID:', e);
        return;
      }

      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: applicationServerKey
      });
      
      console.log('[Push] Suscripción generada:', subscription.endpoint);
      statusEl.textContent = '4/4 Guardando suscripción...';
      
      try {
        const res = await fetch('https://sportdharmapush.faviosuenosapedal.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(subscription)
        });
        const data = await res.json();
        console.log('[Push] Worker respondió:', data);
        statusEl.textContent = '✅ ¡Suscrito! (100% privado, sin emails)';
      } catch (err) {
        console.error('[Push] Error al enviar al Worker:', err);
        statusEl.textContent = '⚠️ Suscripción creada pero no se pudo guardar.';
      }
    } catch (error) {
      console.error('[Push] Error general:', error);
      statusEl.textContent = '❌ Error: ' + error.message;
    }
  });
</script>