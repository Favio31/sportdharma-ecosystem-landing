---
// Componente de suscripción a Web Push con estado persistente y verificación robusta
---

<div class="push-subscribe-container">
  <button id="subscribe-push" class="subscribe-btn">
    <span id="btn-text">Activar Notificaciones</span>
  </button>
  <p id="push-status" class="push-status"></p>
</div>

<script>
  const VAPID_PUBLIC_KEY = 'BKRvq4NiQWfebuVqz_tjZxjS6OaQNHLgCqgExu9b1-os03BJPhPKFnt5c0SsI06GtAiavQbM9Dt8Rwd6WffPGd8';
  const LS_KEY = 'sde_push_active';

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  function setActivated() {
    const btn = document.getElementById('subscribe-push');
    const btnText = document.getElementById('btn-text');
    const statusEl = document.getElementById('push-status');
    btn.classList.add('active');
    btn.disabled = true;
    btnText.textContent = 'Activada';
    statusEl.textContent = 'Ya estás recibiendo nuestras publicaciones.';
    statusEl.style.color = '#10b981';
  }

  async function checkSubscriptionStatus() {
    const btn = document.getElementById('subscribe-push');
    const statusEl = document.getElementById('push-status');
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      statusEl.textContent = 'Tu navegador no soporta notificaciones.';
      statusEl.style.color = '#ef4444';
      btn.disabled = true;
      return;
    }
    try {
      const registration = await navigator.serviceWorker.ready;
      const subscription = await registration.pushManager.getSubscription();
      const stored = localStorage.getItem(LS_KEY) === 'true';
      if ((subscription && Notification.permission === 'granted') || stored) {
        setActivated();
      }
    } catch (e) {
      if (localStorage.getItem(LS_KEY) === 'true') setActivated();
    }
  }

  document.getElementById('subscribe-push')?.addEventListener('click', async () => {
    const btn = document.getElementById('subscribe-push');
    const btnText = document.getElementById('btn-text');
    const statusEl = document.getElementById('push-status');
    try {
      statusEl.textContent = 'Solicitando permiso...';
      statusEl.style.color = '#f59e0b';
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        statusEl.textContent = 'Permiso denegado. Actívalo en la configuración de tu navegador.';
        statusEl.style.color = '#ef4444';
        return;
      }
      btnText.textContent = 'Activando...';
      btn.disabled = true;
      const registration = await navigator.serviceWorker.ready;
      const applicationServerKey = urlBase64ToUint8Array(VAPID_PUBLIC_KEY);
      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey
      });
      const response = await fetch('https://sportdharmaecosystem.com/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(subscription)
      });
      if (response.ok) {
        localStorage.setItem(LS_KEY, 'true');
        setActivated();
      } else {
        throw new Error('Error en el servidor');
      }
    } catch (err) {
      console.error('[PUSH] Error:', err);
      statusEl.textContent = 'Error al activar. Intenta de nuevo.';
      statusEl.style.color = '#ef4444';
      btn.disabled = false;
      btnText.textContent = 'Activar Notificaciones';
    }
  });

  checkSubscriptionStatus();
</script>

<style>
  .push-subscribe-container { text-align: center; }
  .subscribe-btn {
    background: transparent;
    color: #E8530E;
    border: 2px solid #E8530E;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .subscribe-btn:hover:not(:disabled) { background: #E8530E; color: white; }
  .subscribe-btn.active {
    background: #10b981;
    color: white;
    border-color: #10b981;
    cursor: default;
  }
  .subscribe-btn.active:hover { background: #059669; }
  .push-status {
    margin-top: 12px;
    font-weight: 600;
    font-size: 14px;
    min-height: 20px;
  }
</style>