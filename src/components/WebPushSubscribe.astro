---
// Componente para solicitar permiso de notificaciones Push (Privacy-First)
---
<div class="p-6 rounded-2xl border border-black/5 dark:border-white/5 bg-transparent text-center">
  <h3 class="text-xl font-bold text-ink mb-2">🔔 Recibí avisos de nuevo contenido</h3>
  <p class="text-ink-soft text-sm mb-4">Sin emails, sin registro, sin tracking. Solo notificaciones nativas del navegador.</p>
  <button 
    id="subscribe-push"
    class="px-6 py-2 rounded-lg bg-[#E8530E] text-white font-semibold hover:bg-[#d14a0c] transition-colors outline-none! active:scale-95"
  >
    Activar Notificaciones
  </button>
  <p id="push-status" class="text-xs text-ink-soft mt-3 hidden"></p>
</div>

<script>
  const WORKER_URL = "https://sportdharma-push.faviosuenosapedal.workers.dev";
  const VAPID_PUBLIC_KEY = "BNsQsNC5ZMS-b2A_MiYmB-Mq2KpUX8QCiLCV41bpO-L3t6cpw0Pv91TDrqgY77uK5xZzgLnzShhWmKXWmFZA_RM";

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  function showStatus(msg, type) {
    const statusEl = document.getElementById('push-status');
    statusEl.classList.remove('hidden');
    statusEl.textContent = msg;
    const colors = {
      success: 'text-green-600 dark:text-green-400',
      error: 'text-red-500',
      warning: 'text-yellow-600 dark:text-yellow-400',
      info: 'text-blue-600 dark:text-blue-400'
    };
    statusEl.className = 'text-xs mt-3 ' + (colors[type] || colors.info);
  }

  document.getElementById('subscribe-push')?.addEventListener('click', async () => {
    console.log('🔔 [Push] Botón clickeado');
    showStatus('Iniciando...', 'info');

    // Check 1: Service Worker
    if (!('serviceWorker' in navigator)) {
      console.error('❌ [Push] Service Worker no soportado');
      showStatus('Service Worker no soportado en este navegador', 'error');
      return;
    }
    console.log('✅ [Push] Service Worker disponible');

    // Check 2: Push Manager
    if (!('PushManager' in window)) {
      console.error('❌ [Push] PushManager no soportado');
      showStatus('Push no soportado en este navegador', 'error');
      return;
    }
    console.log('✅ [Push] PushManager disponible');

    try {
      // Check 3: Permiso
      console.log(' [Push] Solicitando permiso...');
      const permission = await Notification.requestPermission();
      console.log('📋 [Push] Permiso:', permission);
      
      if (permission !== 'granted') {
        showStatus('Permiso denegado. Activá las notificaciones en la configuración del navegador.', 'warning');
        return;
      }
      showStatus('Registrando suscripción...', 'info');

      // Check 4: Obtener registration
      console.log('🔔 [Push] Obteniendo SW registration...');
      const registration = await navigator.serviceWorker.ready;
      console.log('✅ [Push] SW ready:', registration.scope);

      // Check 5: Suscribirse
      console.log(' [Push] Suscribiendo con VAPID...');
      const subscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });
      console.log('✅ [Push] Suscripción obtenida:', subscription.endpoint);
      showStatus('Guardando en servidor...', 'info');

      // Check 6: Enviar al Worker
      console.log('🔔 [Push] Enviando a:', WORKER_URL + '/subscribe');
      const response = await fetch(WORKER_URL + '/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(subscription)
      });
      console.log('📋 [Push] Response status:', response.status);
      
      const data = await response.json();
      console.log(' [Push] Response data:', data);

      if (response.ok) {
        showStatus('✅ ¡Suscrito! Te avisaremos cuando haya contenido nuevo.', 'success');
      } else {
        showStatus('❌ Error del servidor: ' + (data.error || response.statusText), 'error');
      }
    } catch (err) {
      console.error('❌ [Push] Error completo:', err);
      showStatus('Error: ' + err.message, 'error');
    }
  });
</script>
