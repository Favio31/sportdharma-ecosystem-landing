---
// src/components/WebPushSubscribe.astro
---

<div class="push-subscribe-container">
  <h3>Notificaciones Soberanas</h3>
  <p>Recibí actualizaciones sin dejar tu correo electrónico.</p>
  
  <button id="subscribe-push" class="subscribe-btn">
    🔔 Activar Notificaciones
  </button>
  
  <button id="force-unsubscribe" class="unsubscribe-btn" style="display:none;">
    🗑️ Limpiar y Reinstalar
  </button>
  
  <p id="push-status"></p>
</div>

<script>
  const VAPID_PUBLIC_KEY = 'BKRvq4NiQWfebuVqz_tjZxjS6OaQNHLgCqgExu9b1-os03BJPhPKFnt5c0SsI06GtAiavQbM9Dt8Rwd6WffPGd8';

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  async function forceUnsubscribe() {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;
    try {
      statusEl.textContent = '⏳ Limpiando sistema...';
      const registrations = await navigator.serviceWorker.getRegistrations();
      for (let registration of registrations) {
        const subscription = await registration.pushManager.getSubscription();
        if (subscription) await subscription.unsubscribe();
        await registration.unregister();
      }
      const cacheKeys = await caches.keys();
      await Promise.all(cacheKeys.map(key => caches.delete(key)));
      
      statusEl.textContent = '✅ Limpieza completada. Recargá la página.';
      statusEl.style.color = '#10b981';
      setTimeout(() => window.location.reload(), 2000);
    } catch (error) {
      statusEl.textContent = '❌ Error al limpiar: ' + error.message;
      statusEl.style.color = '#dc2626';
    }
  }

  async function subscribeToPush() {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;

    try {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
        statusEl.textContent = '❌ Navegador no soportado.';
        statusEl.style.color = '#dc2626';
        return;
      }

      statusEl.textContent = '⏳ Solicitando permiso...';
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        statusEl.textContent = '❌ Permiso denegado.';
        statusEl.style.color = '#dc2626';
        return;
      }

      statusEl.textContent = '⏳ Preparando sistema...';
      // Declaración ÚNICA de registration
      const registration = await navigator.serviceWorker.ready;

      // PASO CRÍTICO: Eliminar cualquier suscripción vieja cachéada
      const existingSubscription = await registration.pushManager.getSubscription();
      if (existingSubscription) {
        await existingSubscription.unsubscribe();
        console.log('[SW] Suscripción vieja eliminada forzosamente');
      }

      statusEl.textContent = '⏳ Generando nueva suscripción...';
      const newSubscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });

      statusEl.textContent = '⏳ Guardando en el servidor...';
      // CORRECCIÓN: Usar newSubscription (no subscription)
      const response = await fetch('https://sportdharmapush.faviosuenosapedal.workers.dev/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newSubscription)
      });

      if (response.ok) {
        statusEl.textContent = '✅ ¡Notificaciones activadas con éxito!';
        statusEl.style.color = '#10b981';
        const btn = document.getElementById('subscribe-push');
        if (btn) {
          btn.textContent = '✅ Activado';
          btn.disabled = true;
        }
      } else {
        const errText = await response.text();
        statusEl.textContent = '❌ Error del servidor: ' + errText;
        statusEl.style.color = '#dc2626';
      }
    } catch (error) {
      console.error('Error de suscripción:', error);
      statusEl.textContent = '❌ Error: ' + error.message;
      statusEl.style.color = '#dc2626';
      
      if (error.message.includes('applicationServerKey') || error.message.includes('gcm_sender_id') || error.message.includes('active')) {
        const forceBtn = document.getElementById('force-unsubscribe');
        if (forceBtn) forceBtn.style.display = 'inline-block';
      }
    }
  }

  document.getElementById('subscribe-push')?.addEventListener('click', subscribeToPush);
  document.getElementById('force-unsubscribe')?.addEventListener('click', forceUnsubscribe);
</script>

<style>
  .push-subscribe-container { text-align: center; padding: 20px; }
  .subscribe-btn {
    background: #E8530E; color: white; border: none; padding: 12px 24px;
    border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;
    transition: all 0.3s; display: inline-block; margin-top: 10px;
  }
  .subscribe-btn:hover:not(:disabled) { background: #d14a0c; transform: translateY(-2px); }
  .subscribe-btn:disabled { background: #10b981; cursor: default; }
  .unsubscribe-btn {
    background: #dc2626; color: white; border: none; padding: 10px 20px;
    border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;
    margin-top: 10px; display: none;
  }
  .unsubscribe-btn:hover { background: #b91c1c; }
  #push-status { margin-top: 1rem; font-size: 14px; min-height: 1.5rem; font-weight: 500; }
</style>