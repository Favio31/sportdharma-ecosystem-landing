---
// src/components/WebPushSubscribe.astro
---

<div class="push-subscribe-container">
  <h3>Notificaciones Soberanas</h3>
  <p>Recibí actualizaciones sin dejar tu correo electrónico.</p>
  
  <button id="subscribe-push" class="subscribe-btn">🔔 Activar Notificaciones</button>
  <p id="push-status" style="font-weight: bold; font-size: 16px;"></p>
</div>

<script>
  const VAPID_PUBLIC_KEY = 'BKRvq4NiQWfebuVqz_tjZxjS6OaQNHLgCqgExu9b1-os03BJPhPKFnt5c0SsI06GtAiavQbM9Dt8Rwd6WffPGd8';

  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
      outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
  }

  document.getElementById('subscribe-push')?.addEventListener('click', async () => {
    const statusEl = document.getElementById('push-status');
    if (!statusEl) return;

    try {
      console.log('[PUSH] Paso 1: Iniciando...');
      statusEl.textContent = 'Solicitando permiso...';
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        statusEl.textContent = '❌ Permiso denegado';
        return;
      }

      console.log('[PUSH] Paso 2: Registrando SW...');
      statusEl.textContent = 'Registrando Service Worker...';
      
      // REGISTRO MANUAL DIRECTO Y SIMPLE (más fiable que .ready en Android)
      const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
      console.log('[PUSH] Paso 3: SW registrado:', registration.scope);
      
      if (registration.installing) {
        statusEl.textContent = 'Instalando Service Worker...';
        await new Promise(resolve => {
          registration.installing.addEventListener('statechange', e => {
            if (e.target.state === 'activated' || e.target.state === 'redundant') resolve();
          });
        });
      }
      console.log('[PUSH] Paso 4: SW listo.');

      const existingSubscription = await registration.pushManager.getSubscription();
      if (existingSubscription) {
        await existingSubscription.unsubscribe();
        console.log('[PUSH] Paso 5: Suscripción vieja eliminada');
      }

      statusEl.textContent = 'Generando nueva suscripción...';
      console.log('[PUSH] Paso 6: Generando suscripción...');
      const newSubscription = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
      });

      statusEl.textContent = 'Enviando al servidor...';
      console.log('[PUSH] Paso 7: Enviando al servidor...');
      const subscriptionData = {
        endpoint: newSubscription.endpoint,
        keys: newSubscription.toJSON().keys,
        lang: navigator.language.split('-')[0].toLowerCase()
      };
      
      const response = await fetch('https://sportdharmapush.faviosuenosapedal.workers.dev/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(subscriptionData)
      });

      if (response.ok) {
        statusEl.textContent = '✅ ¡Notificaciones activadas con éxito!';
        statusEl.style.color = 'green';
        console.log('[PUSH] Paso 8: ÉXITO TOTAL');
      } else {
        statusEl.textContent = '❌ Error al guardar en el servidor';
        statusEl.style.color = 'red';
      }
    } catch (err) {
      console.error('[PUSH] ERROR CRÍTICO:', err);
      statusEl.textContent = '❌ Error: ' + err.message;
      statusEl.style.color = 'red';
    }
  });
</script>

<style>
  .push-subscribe-container { text-align: center; }
  .subscribe-btn {
    background: #E8530E; color: white; border: none; padding: 12px 24px;
    border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;
    transition: all 0.3s; display: inline-block;
  }
  .subscribe-btn:hover:not(:disabled) { background: #d14a0c; transform: translateY(-2px); }
  .subscribe-btn:disabled { background: #10b981; cursor: default; }
  #push-status { margin-top: 1rem; font-size: 14px; min-height: 1.5rem; }
</style>