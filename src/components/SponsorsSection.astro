---
// Sección Sponsors - 4 sponsors ficticios
---
<section class="relative overflow-hidden py-20 px-4 md:px-8 bg-gradient-to-r from-cyan-500/10 via-blue-600/10 to-blue-900/10">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-cyan-400 font-semibold text-sm uppercase tracking-wider mb-2">Aliados Estratégicos</p>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mb-3">Sponsors</h2>
      <p class="text-ink-soft max-w-2xl mx-auto">Empresas que comparten nuestra visión de tecnología soberana, offline-first y comunidad global.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Sponsor 1: AlpineGear -->
      <div class="group relative rounded-2xl border border-gray-300 dark:border-gray-600 bg-white/5 dark:bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-[0_0_30px_-8px_rgba(6,182,212,0.3)]">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-4 text-white text-xl font-black">A</div>
        <h3 class="text-lg font-bold text-ink mb-1 group-hover:text-cyan-400 transition-colors">AlpineGear</h3>
        <p class="text-xs text-ink-soft mb-3">Equipamiento outdoor sostenible</p>
        <span class="inline-block px-2 py-1 text-[10px] font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-500/10 rounded-full">Patrocinador</span>
      </div>

      <!-- Sponsor 2: TrailTech -->
      <div class="group relative rounded-2xl border border-gray-300 dark:border-gray-600 bg-white/5 dark:bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-[0_0_30px_-8px_rgba(6,182,212,0.3)]">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-4 text-white text-xl font-black">T</div>
        <h3 class="text-lg font-bold text-ink mb-1 group-hover:text-cyan-400 transition-colors">TrailTech</h3>
        <p class="text-xs text-ink-soft mb-3">GPS y navegación offline</p>
        <span class="inline-block px-2 py-1 text-[10px] font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-500/10 rounded-full">Patrocinador</span>
      </div>

      <!-- Sponsor 3: EcoRide -->
      <div class="group relative rounded-2xl border border-gray-300 dark:border-gray-600 bg-white/5 dark:bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-[0_0_30px_-8px_rgba(6,182,212,0.3)]">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-4 text-white text-xl font-black">E</div>
        <h3 class="text-lg font-bold text-ink mb-1 group-hover:text-cyan-400 transition-colors">EcoRide</h3>
        <p class="text-xs text-ink-soft mb-3">Bicicletas y movilidad verde</p>
        <span class="inline-block px-2 py-1 text-[10px] font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-500/10 rounded-full">Patrocinador</span>
      </div>

      <!-- Sponsor 4: SummitLabs -->
      <div class="group relative rounded-2xl border border-gray-300 dark:border-gray-600 bg-white/5 dark:bg-surface/50 p-6 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-[0_0_30px_-8px_rgba(6,182,212,0.3)]">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center mb-4 text-white text-xl font-black">S</div>
        <h3 class="text-lg font-bold text-ink mb-1 group-hover:text-cyan-400 transition-colors">SummitLabs</h3>
        <p class="text-xs text-ink-soft mb-3">Software open source para aventura</p>
        <span class="inline-block px-2 py-1 text-[10px] font-semibold tracking-wider text-cyan-400 uppercase bg-cyan-500/10 rounded-full">Patrocinador</span>
      </div>
    </div>
  </div>
</section>