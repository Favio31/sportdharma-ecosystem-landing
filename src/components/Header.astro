---
// Header SportDharma Ecosystem
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0B0F1A] dark:bg-surface transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6 py-6">
    <div class="flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.png" alt="SportDharma Ecosystem" class="h-14 w-auto" />
      </a>

      <!-- Navegación -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#pilares" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Pilares
        </a>
        <a href="#ecosistema" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Ecosistema
        </a>
        <a href="#contacto" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Contacto
        </a>
        
        <!-- Selector de idioma -->
        <div class="flex items-center gap-2">
          <button class="bg-transparent text-white font-semibold text-sm px-4 py-1.5 border border-white rounded hover:bg-white hover:text-slate-900 transition-colors">
            Español
          </button>
          <button class="bg-transparent text-white font-semibold text-sm px-4 py-1.5 border border-white rounded hover:bg-white hover:text-slate-900 transition-colors">
            English
          </button>
        </div>

        <!-- Theme Toggle - con más espacio -->
        <div class="flex items-center gap-1 ml-6 pl-6 border-l-2 border-white">
          <button data-theme-btn="system" class="p-2.5 rounded hover:bg-slate-700 transition-colors" aria-label="Tema sistema">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>
          <button data-theme-btn="light" class="p-2.5 rounded hover:bg-slate-700 transition-colors" aria-label="Tema claro">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </button>
          <button data-theme-btn="dark" class="p-2.5 rounded hover:bg-slate-700 transition-colors" aria-label="Tema oscuro">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const getTheme = () => localStorage.getItem('theme') || 'system';

  function apply(theme: string) {
    const dark = theme === 'dark' || (theme === 'system' && mq.matches);
    root.classList.toggle('dark', dark);
    localStorage.setItem('theme', theme);
    
    document.querySelectorAll<HTMLElement>('[data-theme-btn]').forEach((btn) => {
      const active = btn.dataset.themeBtn === theme;
      btn.classList.toggle('bg-slate-700', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-theme-btn]').forEach((btn) =>
    btn.addEventListener('click', () => apply(btn.dataset.themeBtn!))
  );

  mq.addEventListener('change', () => { 
    if (getTheme() === 'system') apply('system'); 
  });

  apply(getTheme());
</script>