---
// Header SportDharma Ecosystem
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0B0F1A]">
  <div class="max-w-6xl mx-auto px-6 py-6">
    <div class="flex items-center justify-between">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.png" alt="SportDharma Ecosystem" class="h-14 w-auto" />
      </a>

      <!-- Navegación -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#pilares" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Pilares
        </a>
        <a href="#ecosistema" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Ecosistema
        </a>
        <a href="#contacto" class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide">
          Contacto
        </a>
        
        <!-- Selector de idioma -->
        <div class="flex items-center gap-2">
          <button class="bg-transparent text-white font-semibold text-sm px-4 py-1.5 border border-white rounded hover:bg-white hover:text-slate-900 transition-colors">
            Español
          </button>
          <button class="bg-transparent text-white font-semibold text-sm px-4 py-1.5 border border-white rounded hover:bg-white hover:text-slate-900 transition-colors">
            English
          </button>
        </div>

        <!-- Theme Toggle (3 botones) -->
        <div class="flex items-center gap-1 ml-2 pl-2 border-l-2 border-white">
          <button id="btn-system" class="p-2 rounded hover:bg-slate-700 transition-colors" aria-label="Tema sistema">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>
          <button id="btn-light" class="p-2 rounded hover:bg-slate-700 transition-colors" aria-label="Tema claro">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </button>
          <button id="btn-dark" class="p-2 rounded hover:bg-slate-700 transition-colors" aria-label="Tema oscuro">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <script>
    const getTheme = () => localStorage.getItem('theme') || 'system';
    const setTheme = (theme) => {
      const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);
      localStorage.setItem('theme', theme);
      ['btn-system', 'btn-light', 'btn-dark'].forEach(id => {
        document.getElementById(id).classList.toggle('bg-slate-700', id === 'btn-' + theme);
      });
    };
    setTheme(getTheme());
    document.getElementById('btn-system').addEventListener('click', () => setTheme('system'));
    document.getElementById('btn-light').addEventListener('click', () => setTheme('light'));
    document.getElementById('btn-dark').addEventListener('click', () => setTheme('dark'));
  </script>
</header>