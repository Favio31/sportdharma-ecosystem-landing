---
// Componente reutilizable para artículos curados
interface Props {
  titulo: string;
  fuente: string;
  fecha: string;
  resumen: string;
  url: string;
}

const { titulo, fuente, fecha, resumen, url } = Astro.props;
---

<article class="bg-white border border-slate-200 rounded-xl p-6 hover:border-emerald-500 transition-all">
  <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
    <span>{fuente}</span>
    <span>•</span>
    <span>{fecha}</span>
  </div>
  <h3 class="text-lg font-bold text-slate-900 mb-2">{titulo}</h3>
  <p class="text-sm text-slate-600 mb-4">{resumen}</p>
  <a href={url} target="_blank" rel="noopener" class="text-emerald-600 hover:text-emerald-700 text-sm font-semibold">
    Leer más →
  </a>
</article>