---
// Flyer SVG Táctico HUD - APP / WEBPAGE / MASF
// Enmarcado, estático, tipografía tech, MASF en naranja
---
<div class="relative mx-auto w-full max-w-[420px] sm:max-w-[480px] lg:max-w-[540px] aspect-square overflow-hidden rounded-2xl border-2 border-gray-400 bg-[#0f172a] shadow-[0_18px_50px_-12px_rgba(0,0,0,0.7),0_0_0_1px_rgba(255,255,255,0.06)]">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1080 1080" preserveAspectRatio="xMidYMid meet" class="tactical-hud-flyer block h-full w-full" role="img" aria-label="SportDharma Ecosystem: APP, WEBPAGE y MASF">
    <defs>
      <radialGradient id="glow-green" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#00ff41;stop-opacity:0.8"/><stop offset="100%" style="stop-color:#00ff41;stop-opacity:0"/></radialGradient>
      <radialGradient id="glow-cyan" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#22d3ee;stop-opacity:0.8"/><stop offset="100%" style="stop-color:#22d3ee;stop-opacity:0"/></radialGradient>
      <radialGradient id="glow-orange" cx="50%" cy="50%" r="50%"><stop offset="0%" style="stop-color:#E8530E;stop-opacity:0.8"/><stop offset="100%" style="stop-color:#E8530E;stop-opacity:0"/></radialGradient>
      <filter id="glow"><feGaussianBlur stdDeviation="4" result="coloredBlur"/><feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <pattern id="tactical-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="0.5" opacity="0.1"/></pattern>
    </defs>
    <rect width="1080" height="1080" fill="url(#tactical-grid)" opacity="0.3"/>
    <g stroke="#ffffff" stroke-width="2" opacity="0.4">
      <line x1="20" y1="20" x2="60" y2="20"/><line x1="20" y1="20" x2="20" y2="60"/>
      <line x1="1060" y1="20" x2="1020" y2="20"/><line x1="1060" y1="20" x2="1060" y2="60"/>
      <line x1="20" y1="1060" x2="60" y2="1060"/><line x1="20" y1="1060" x2="20" y2="1020"/>
      <line x1="1060" y1="1060" x2="1020" y2="1060"/><line x1="1060" y1="1060" x2="1060" y2="1020"/>
    </g>
    <g fill="none" stroke-width="2" opacity="0.6">
      <path d="M 300 540 Q 450 400 540 300" stroke="#00ff41" stroke-dasharray="8,4"/>
      <path d="M 620 300 Q 720 400 780 540" stroke="#22d3ee" stroke-dasharray="8,4"/>
      <path d="M 780 620 Q 540 750 300 620" stroke="#E8530E" stroke-dasharray="8,4"/>
    </g>
    <g transform="translate(180, 480)">
      <circle cx="120" cy="120" r="140" fill="url(#glow-green)" opacity="0.3"/>
      <rect x="60" y="40" width="120" height="200" rx="12" fill="#1a1a1a" stroke="#00ff41" stroke-width="3" filter="url(#glow)"/>
      <rect x="70" y="60" width="100" height="160" fill="#0a0a0a"/>
      <g stroke="#00ff41" stroke-width="1.5" fill="none" opacity="0.8">
        <path d="M 80 100 Q 100 90 120 100 T 160 100"/><path d="M 80 120 Q 100 110 120 120 T 160 120"/>
        <path d="M 80 140 Q 100 130 120 140 T 160 140"/><path d="M 80 160 Q 100 150 120 160 T 160 160"/>
        <path d="M 80 180 Q 100 170 120 180 T 160 180"/>
      </g>
      <text x="75" y="210" font-family="monospace" font-size="10" fill="#00ff41" opacity="0.7">45.23°N</text>
      <text x="75" y="222" font-family="monospace" font-size="10" fill="#00ff41" opacity="0.7">12.45°E</text>
      <text x="120" y="280" font-family="monospace" font-size="32" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#glow)">APP</text>
    </g>
    <g transform="translate(440, 200)">
      <circle cx="100" cy="80" r="120" fill="url(#glow-cyan)" opacity="0.3"/>
      <rect x="20" y="20" width="160" height="120" rx="8" fill="#1a1a1a" stroke="#22d3ee" stroke-width="3" filter="url(#glow)"/>
      <rect x="20" y="20" width="160" height="20" rx="8" fill="#0a0a0a"/>
      <circle cx="35" cy="30" r="3" fill="#ff5f56"/><circle cx="45" cy="30" r="3" fill="#ffbd2e"/><circle cx="55" cy="30" r="3" fill="#27c93f"/>
      <g stroke="#22d3ee" stroke-width="1" opacity="0.6">
        <line x1="30" y1="55" x2="170" y2="55"/><line x1="30" y1="70" x2="170" y2="70"/>
        <line x1="30" y1="85" x2="170" y2="85"/><line x1="30" y1="100" x2="170" y2="100"/><line x1="30" y1="115" x2="170" y2="115"/>
      </g>
      <g fill="#22d3ee" opacity="0.7">
        <rect x="35" y="50" width="40" height="3" rx="1"/><rect x="80" y="50" width="60" height="3" rx="1"/>
        <rect x="35" y="65" width="50" height="3" rx="1"/><rect x="90" y="65" width="45" height="3" rx="1"/>
        <rect x="35" y="80" width="35" height="3" rx="1"/><rect x="75" y="80" width="70" height="3" rx="1"/>
      </g>
      <text x="100" y="175" font-family="monospace" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#glow)">WEBPAGE</text>
    </g>
    <g transform="translate(680, 480)">
      <circle cx="120" cy="120" r="140" fill="url(#glow-orange)" opacity="0.3"/>
      <g stroke="#E8530E" stroke-width="2" fill="none" filter="url(#glow)">
        <polygon points="120,80 140,90 140,110 120,120 100,110 100,90" fill="#E8530E" opacity="0.3"/>
        <polygon points="80,60 95,68 95,82 80,90 65,82 65,68" opacity="0.6"/>
        <polygon points="160,60 175,68 175,82 160,90 145,82 145,68" opacity="0.6"/>
        <polygon points="80,140 95,148 95,162 80,170 65,162 65,148" opacity="0.6"/>
        <polygon points="160,140 175,148 175,162 160,170 145,162 145,148" opacity="0.6"/>
        <polygon points="120,40 135,48 135,62 120,70 105,62 105,48" opacity="0.6"/>
        <polygon points="120,170 135,178 135,192 120,200 105,192 105,178" opacity="0.6"/>
      </g>
      <g stroke="#E8530E" stroke-width="1" opacity="0.5">
        <line x1="120" y1="80" x2="80" y2="75"/><line x1="120" y1="80" x2="160" y2="75"/>
        <line x1="120" y1="120" x2="80" y2="155"/><line x1="120" y1="120" x2="160" y2="155"/>
        <line x1="120" y1="80" x2="120" y2="40"/><line x1="120" y1="120" x2="120" y2="170"/>
      </g>
      <text x="120" y="240" font-family="monospace" font-size="28" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#glow)">MASF</text>
      <text x="120" y="265" font-family="monospace" font-size="12" fill="#E8530E" text-anchor="middle" opacity="0.9">Multi Agent Swarm</text>
      <text x="120" y="280" font-family="monospace" font-size="12" fill="#E8530E" text-anchor="middle" opacity="0.9">Framework</text>
    </g>
    <g font-family="monospace" font-size="14" fill="#ffffff" opacity="0.8">
      <g transform="translate(80, 100)">
        <rect x="0" y="0" width="80" height="30" rx="4" fill="#000000" stroke="#00ff41" stroke-width="2"/>
        <text x="40" y="20" text-anchor="middle" fill="#00ff41" font-weight="bold">[FOSS]</text>
      </g>
      <g transform="translate(920, 100)">
        <rect x="0" y="0" width="140" height="30" rx="4" fill="#000000" stroke="#22d3ee" stroke-width="2"/>
        <text x="70" y="20" text-anchor="middle" fill="#22d3ee" font-weight="bold">[OFFLINE-FIRST]</text>
      </g>
      <g transform="translate(80, 950)">
        <rect x="0" y="0" width="140" height="30" rx="4" fill="#000000" stroke="#E8530E" stroke-width="2"/>
        <text x="70" y="20" text-anchor="middle" fill="#E8530E" font-weight="bold">[OPEN-SOURCE]</text>
      </g>
      <g transform="translate(920, 950)">
        <text x="0" y="0" fill="#ffffff" opacity="0.6">45.2345°N</text>
        <text x="0" y="18" fill="#ffffff" opacity="0.6">12.4567°E</text>
        <text x="0" y="36" fill="#ffffff" opacity="0.6">ALT: 234m</text>
      </g>
    </g>
    <text x="540" y="900" font-family="monospace" font-size="48" font-weight="bold" fill="#ffffff" text-anchor="middle" filter="url(#glow)" opacity="0.9">SportDharma Ecosystem</text>
    <text x="540" y="940" font-family="monospace" font-size="20" fill="#ffffff" text-anchor="middle" opacity="0.7">Software Soberano · Transparente · Modular</text>
  </svg>
</div>