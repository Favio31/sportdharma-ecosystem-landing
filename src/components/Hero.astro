---
// Hero Section con imagen de fondo
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden">
  
  <!-- Imagen de fondo con overlay oscuro para garantizar lectura en ambos modos -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/hero-bike.jpg" 
      alt="Cicloviaje con GPS offline" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-slate-900/60"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 px-6 max-w-6xl mx-auto py-32">
    
    <!-- Badge -->
    <div class="flex justify-center mb-12">
      <div class="inline-flex items-center gap-3 bg-slate-900/80 border border-slate-700 rounded-full px-6 py-3 backdrop-blur-sm">
        <span class="flex items-center gap-3 text-slate-300 text-base font-mono tracking-wide">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span>
            Software libre
          </span>
          <span class="text-slate-500">·</span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span>
            Local-first
          </span>
          <span class="text-slate-500">·</span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-pulse"></span>
            Privacidad total
          </span>
        </span>
      </div>
    </div>

    <!-- Título línea 1 -->
    <h1 class="text-5xl md:text-7xl font-bold text-white text-center mb-2 leading-tight">
      Infraestructura libre para
    </h1>
    <!-- Título línea 2 -->
    <h1 class="text-5xl md:text-7xl font-bold text-slate-300 text-right md:pr-24 lg:pr-40 mb-12 leading-tight">
      quienes viven en libertad
    </h1>

    <!-- Subtítulo -->
    <div class="max-w-lg ml-[15%] text-center mb-10">
      <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
        Nueve pilares. Arquitectura soberana. Resiliencia outdoor.<br />
        Un ecosistema abierto para deportistas, equipos de<br />
        primera respuesta, comunidades aisladas<br />
        y territorios sin conectividad.
      </p>
    </div>

    <!-- Botones -->
    <div class="flex flex-col sm:flex-row gap-4 justify-end mb-16">
      <a href="#pilares" class="bg-transparent border-2 border-slate-300 text-white px-8 py-4 rounded-lg font-semibold hover:bg-slate-300 hover:text-slate-900 transition-colors">
        Explorar los Nueve Pilares
      </a>
      <a href="#ecosistema" class="bg-transparent border-2 border-slate-300 text-white px-8 py-4 rounded-lg font-semibold hover:bg-slate-300 hover:text-slate-900 transition-colors">
        Ver el Ecosistema
      </a>
    </div>

    <!-- Stats -->
    <div class="flex justify-end gap-8 md:gap-16 lg:gap-24">
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-white">9</div>
        <div class="text-sm text-slate-300 mt-1">Pilares</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-white">100%</div>
        <div class="text-sm text-slate-300 mt-1">Código Abierto</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-white">0</div>
        <div class="text-sm text-slate-300 mt-1">Cookies</div>
      </div>
    </div>

  </div>
</section>