---
// Componente reutilizable para los 9 Pilares
interface Props {
  numero: string;
  titulo: string;
  descripcion: string;
  icono: string;
}

const { numero, titulo, descripcion, icono } = Astro.props;
---

<article class="bg-surface border border-line rounded-xl p-6 shadow-sm hover:shadow-lg hover:border-emerald-500 dark:hover:border-emerald-400 transition-all duration-300">
  <div class="flex items-start gap-4">
    <!-- Número + Icono -->
    <div class="flex-shrink-0 w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-lg flex items-center justify-center text-2xl">
      {icono}
    </div>
    <!-- Contenido -->
    <div class="flex-1">
      <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide">Pilar {numero}</span>
      <h3 class="text-lg font-bold text-ink mt-1">{titulo}</h3>
      <p class="text-sm text-ink-soft mt-2 leading-relaxed">{descripcion}</p>
    </div>
  </div>
</article>