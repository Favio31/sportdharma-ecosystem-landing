---
import LanguageSelector from '../LanguageSelector.astro';

import { useTranslations } from '../../i18n/utils.js';

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0B0F1A] dark:bg-surface transition-colors duration-300 border-b border-white/10 dark:border-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
    <div class="flex items-center justify-between">
      
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-3">
        <img src="/logo.png" alt="SportDharma Ecosystem" class="h-10 sm:h-14 w-auto" />
      </a>

      <!-- Botón Menú Móvil (Hamburguesa) -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-white hover:bg-white/10 rounded-lg transition-colors" aria-label="{t('header.open_menu')}">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <!-- Navegación Desktop (oculta en móvil) -->
      <nav class="hidden md:flex items-center gap-8">
        <a href={`/${lang}/#pilares`} class="text-white hover:text-slate-300 transition-colors font-semibold text-sm uppercase tracking-wide">
          {t('header.nav_pillars')}
        </a>
        <a href={`/${lang}/#ecosistema`} class="text-white hover:text-slate-300 transition-colors font-semibold text-sm uppercase tracking-wide">
          {t('header.nav_ecosystem')}
        </a>
        <a href={`/${lang}/#contacto`} class="text-white hover:text-slate-300 transition-colors font-semibold text-sm uppercase tracking-wide">
          {t('header.nav_contact')}
        </a>
        
        <!-- Selector de idioma dinámico (5 idiomas) -->
        <div class="flex items-center gap-2 ml-4 pl-4 border-l-2 border-white/30">
          <LanguageSelector {lang} />
        </div>

        <!-- Theme Toggle -->
        <div class="flex items-center gap-1 ml-4 pl-4 border-l-2 border-white/30">
          <button data-theme-btn="system" class="p-2 rounded hover:bg-white/10 transition-colors" aria-label="{t('header.theme_system')}">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>
          <button data-theme-btn="light" class="p-2 rounded hover:bg-white/10 transition-colors" aria-label="{t('header.theme_light')}">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </button>
          <button data-theme-btn="dark" class="p-2 rounded hover:bg-white/10 transition-colors" aria-label="{t('header.theme_dark')}">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Menú Móvil Desplegable -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#0B0F1A] dark:bg-surface border-t border-white/10 dark:border-line transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6">
      <a href={`/${lang}/#pilares`} class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide border-b border-white/10 pb-2">
        {t('header.nav_pillars')}
      </a>
      <a href={`/${lang}/#ecosistema`} class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide border-b border-white/10 pb-2">
        {t('header.nav_ecosystem')}
      </a>
      <a href={`/${lang}/#contacto`} class="text-white hover:text-slate-300 transition-colors font-semibold text-lg uppercase tracking-wide border-b border-white/10 pb-2">
        {t('header.nav_contact')}
      </a>
      
      <!-- Selector de idioma móvil dinámico -->
      <div class="pt-2 border-t border-white/10">
        <p class="text-slate-400 text-sm mb-2">{t('header.mobile_lang_label')}</p>
        <LanguageSelector {lang} />
      </div>

      <!-- Theme Toggle Móvil -->
      <div class="flex items-center justify-center gap-4 pt-4 border-t border-white/10">
        <span class="text-slate-400 text-sm">{t('header.mobile_theme_label')}</span>
        <button data-theme-btn="system" class="p-2 rounded bg-white/10 text-white hover:bg-white/20 transition-colors" aria-label="{t('header.theme_system')}">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </button>
        <button data-theme-btn="light" class="p-2 rounded bg-white/10 text-white hover:bg-white/20 transition-colors" aria-label="{t('header.theme_light')}">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <button data-theme-btn="dark" class="p-2 rounded bg-white/10 text-white hover:bg-white/20 transition-colors" aria-label="{t('header.theme_dark')}">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // 1. Lógica del menú móvil
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // 2. Lógica del tema
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const getTheme = () => localStorage.getItem('theme') || 'system';

  function apply(theme) {
    const dark = theme === 'dark' || (theme === 'system' && mq.matches);
    root.classList.toggle('dark', dark);
    localStorage.setItem('theme', theme);
    
    document.querySelectorAll('[data-theme-btn]').forEach((btn) => {
      const active = btn.dataset.themeBtn === theme;
      btn.classList.toggle('bg-white/20', active);
      btn.classList.toggle('text-[#E8530E]', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  }

  document.querySelectorAll('[data-theme-btn]').forEach((btn) =>
    btn.addEventListener('click', () => apply(btn.dataset.themeBtn))
  );

  mq.addEventListener('change', () => { 
    if (getTheme() === 'system') apply('system'); 
  });

  apply(getTheme());
</script>