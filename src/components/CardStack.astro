---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const src = `${base}/ecosistema-diagram-transparente.jpg`;
---

<div
  class="card-stack"
  role="img"
  aria-label="Mazo de tarjetas con el diagrama del ecosistema"
>
  <div class="card-stack-shuffle" aria-hidden="true">
    <div class="card"><img src={src} alt="" decoding="async" /></div>
    <div class="card"><img src={src} alt="" decoding="async" /></div>
    <div class="card"><img src={src} alt="" decoding="async" /></div>
  </div>
</div>

<style>
  .card-stack {
    font-size: 1rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 2.5em 2.5em 2em 3.5em;
  }

  .card-stack-shuffle {
    position: relative;
    width: 11em;
    height: 11em;
  }

  .card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 0.8em;
    background: #0a0a0a;
    /* Bordes GRIS (slate-400) */
    border: 1.5px solid rgb(148 163 184 / 0.5);
    /* Sombra negra de profundidad, SIN glow naranja */
    box-shadow: 0 0.6em 1.2em rgb(0 0 0 / 0.6);
    will-change: transform;
  }

  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ESTADO POR DEFECTO = mazo estatico (reduced-motion y fallback) */
  .card:nth-child(1) { transform: none; z-index: 3; }
  .card:nth-child(2) { transform: translate(0.8em, -0.8em) rotate(3deg) scale(0.97); z-index: 2; }
  .card:nth-child(3) { transform: translate(1.6em, -1.6em) rotate(6deg) scale(0.94); z-index: 1; }

  /* ANIMACION: solo si el usuario NO pidio reducir movimiento */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      animation: deal 6s ease-in-out infinite;
    }
    .card:nth-child(1) { animation-delay: 0s; }
    .card:nth-child(2) { animation-delay: -4s; }
    .card:nth-child(3) { animation-delay: -2s; }

    @keyframes deal {
      0%      { transform: none; z-index: 3; }
      5%      { transform: translate(-2.2em, 0.3em) rotate(-9deg); z-index: 4; }
      12%, 33.33% { transform: translate(1.6em, -1.6em) rotate(6deg) scale(0.94); z-index: 1; }
      45.33%, 66.67% { transform: translate(0.8em, -0.8em) rotate(3deg) scale(0.97); z-index: 2; }
      78.67%, 100% { transform: none; z-index: 3; }
    }
  }
</style>