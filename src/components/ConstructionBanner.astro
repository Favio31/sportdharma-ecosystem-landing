---
// Banner sticky superior: logo SportDharma (fondo blanco circular) + texto + logo GitHub (solo home)
interface Props { lang: string }
const { lang } = Astro.props;

const messages: Record<string, string> = {
  es: 'Página Web en Construcción Activa | Seguinos en GitHub',
  en: 'Website Under Active Construction | Follow us on GitHub',
  fr: 'Site Web en Construction Active | Suivez-nous sur GitHub',
  pt: 'Site em Construção Ativa | Siga-nos no GitHub',
  de: 'Website im aktiven Aufbau | Folge uns auf GitHub',
  it: 'Sito Web in Costruzione Attiva | Seguici su GitHub'
};
const message = messages[lang] || messages['es'];
const repoUrl = 'https://github.com/Favio31/sportdharma-ecosystem-landing';
---

<a
  href={repoUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="construction-banner"
  aria-label="SportDharma Ecosystem on GitHub"
>
  <!-- Logo SportDharma (fondo blanco circular) -->
  <img
    src="/logo.jpg"
    alt="SportDharma Ecosystem"
    class="construction-banner__logo-sd"
    width="26"
    height="26"
    draggable="false"
  />

  <!-- Texto central -->
  <span class="construction-banner__text">{message}</span>

  <!-- Logo GitHub (SVG blanco) -->
  <svg class="construction-banner__logo-gh" viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
  </svg>
</a>

<style is:global>
  .construction-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    background-color: #E8530E;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.625rem 1rem;
    text-decoration: none;
    position: sticky;
    top: calc(var(--header-h) + 0.5rem);
    z-index: 40;
    transition: background-color 0.2s ease;
  }
  .construction-banner:hover {
    background-color: #c9460b;
  }
  .construction-banner__logo-sd {
    flex-shrink: 0;
    background-color: #ffffff;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.4);
    padding: 2px;
    object-fit: cover;
  }
  .construction-banner__logo-gh {
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .construction-banner {
      font-size: 0.7rem;
      padding: 0.5rem 0.625rem;
      gap: 0.4rem;
    }
    .construction-banner__logo-sd {
      width: 22px;
      height: 22px;
    }
    .construction-banner__logo-gh {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  // Medir altura del header y guardarla en variable CSS
  const header = document.querySelector('header');
  if (header) {
    const headerHeight = header.offsetHeight;
    document.documentElement.style.setProperty('--header-h', headerHeight + 'px');
  }
</script>
