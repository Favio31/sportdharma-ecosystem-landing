---
const { lang } = Astro.props;
const items = [
  { icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4', title: 'Revisión de la bicicleta' },
  { icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', title: 'Revisión del equipamiento' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z', title: 'Calentamiento' },
  { icon: 'M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z', title: 'Frase del día' },
  { icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7', title: 'Abrir OpenStreetMap' },
  { icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z', title: 'App de clima' },
  { icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z', title: 'Cuidado físico' }
];
---
<section class="relative overflow-hidden py-20 px-4 md:px-8 bg-gradient-to-r from-[#3E2723] via-[#5D4037] to-[#8D6E63]">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <p class="text-amber-200 font-semibold text-sm uppercase tracking-wider mb-2">Preparación Diaria</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">Antes de Pedalear | Lista de Verificación</h2>
      <p class="text-amber-100/90 max-w-2xl mx-auto">Tu ritual soberano antes de salir a la ruta. Seguridad, mecánica y mente en un solo vistazo.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
      {items.map((item, i) => (
        <div class="flex items-center gap-3 p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:bg-white/10 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-amber-500/20 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path></svg>
          </div>
          <span class="text-white font-medium text-sm">{item.title}</span>
        </div>
      ))}
      <!-- 7th item centered on large screens -->
      <div class="flex items-center gap-3 p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:bg-white/10 transition-colors sm:col-span-2 lg:col-span-4 lg:max-w-xs lg:mx-auto">
        <div class="w-10 h-10 rounded-lg bg-amber-500/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <span class="text-white font-medium text-sm">Cuidado físico</span>
      </div>
    </div>

    <div class="text-center">
      <a href={`/${lang}/checklist/`} class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-white text-[#3E2723] font-bold hover:bg-amber-100 transition-all shadow-lg hover:shadow-amber-500/20">
        Ver la lista completa e interactiva
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
    </div>
  </div>
</section>