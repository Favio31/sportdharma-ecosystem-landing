---
// Sección Publicaciones Diarias (9 categorías) + Portal "Noticias e Información" (Notificaciones + RSS)
import WebPushSubscribe from './WebPushSubscribe.astro';

interface Props { lang: string }
const { lang } = Astro.props;
---

<section id="publicaciones" class="py-20 px-6 bg-surface-alt transition-colors duration-300">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-16">
      <span class="text-[#E8530E] dark:text-orange-500 font-semibold uppercase tracking-wide text-sm">Publicaciones Diarias</span>
      <h2 class="text-3xl md:text-5xl font-bold text-ink mt-3 mb-4">
        Curación <span class="text-ink-soft">humana</span>, 9 categorías
      </h2>
      <p class="text-lg text-ink-soft max-w-2xl mx-auto">
        Contenido filtrado por humanos, sin algoritmos, sin trackers. Publicaciones diarias para quienes viven en ruta.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M13 8H7"/><path d="M17 12H7"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Frase del día</h3>
        <p class="text-sm text-ink-soft mb-4">Inspiración diaria para el camino y la mente.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Deporte</h3>
        <p class="text-sm text-ink-soft mb-4">Ciclismo, mecánica, caminata, running, trekking.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 11l5.96 1"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Salud</h3>
        <p class="text-sm text-ink-soft mb-4">Nutrición, recuperación física, salud mental en ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M12 7v14"/><path d="M16 12h2"/><path d="M16 8h2"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/><path d="M6 12h2"/><path d="M6 8h2"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Educación</h3>
        <p class="text-sm text-ink-soft mb-4">Primeros auxilios, supervivencia, habilidades blandas.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Open Source</h3>
        <p class="text-sm text-ink-soft mb-4">Noticias FOSS, grants, herramientas de privacidad.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 12c2.21 0 4 -1.567 4 -3.5s-1.79 -3.5 -4 -3.5c-1.594 0 -2.97 .816 -3.613 2"/><path d="M3.423 14.483a4.944 4.944 0 0 0 -.423 2.017c0 2.485 1.79 4.5 4 4.5s4 -2.015 4 -4.5s-1.79 -4.5 -4 -4.5"/><path d="M14.071 17.01c.327 2.277 1.739 3.99 3.429 3.99c1.933 0 3.5 -2.239 3.5 -5s-1.567 -5 -3.5 -5c-.96 0 -1.868 .606 -2.5 1.5c-.717 1.049 -1.76 1.7 -2.936 1.7c-.92 0 -1.766 -.406 -2.434 -1.087"/><path d="M17 3l2 2"/><path d="M12 3c1.667 3.667 4.667 5.333 9 5"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Espiritualidad</h3>
        <p class="text-sm text-ink-soft mb-4">Tai Chi, yoga, meditación, filosofía de ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M3.5 21 14 3"/><path d="M20.5 21 10 3"/><path d="M15.5 21 12 15l-3.5 6"/><path d="M2 21h20"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Viaje</h3>
        <p class="text-sm text-ink-soft mb-4">Camping, logística, fronteras, finanzas en ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Extra 1</h3>
        <p class="text-sm text-ink-soft mb-4">Contenido especial en definición.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Extra 2</h3>
        <p class="text-sm text-ink-soft mb-4">Contenido especial en definición.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
    </div>

    <!-- PORTAL: NOTICIAS E INFORMACIÓN (Notificaciones + RSS) -->
    <div class="mt-20">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-ink mb-3">Noticias e Información</h2>
        <p class="text-ink-soft text-lg max-w-2xl mx-auto">Recibí las novedades sin dejar tu correo. Notificaciones soberanas y RSS open source.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start max-w-4xl mx-auto">
        <div class="p-8 rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent hover:border-[#E8530E]/40 transition-all flex flex-col justify-between h-full">
          <div>
            <div class="text-5xl mb-4">🔔</div>
            <h3 class="text-2xl font-bold text-ink mb-2">Notificaciones Soberanas</h3>
            <p class="text-ink-soft mb-6">Recibí actualizaciones sin dejar tu correo electrónico.</p>
            <div class="flex justify-center"><WebPushSubscribe /></div>
          </div>
        </div>
        <div class="p-8 rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent hover:border-[#E8530E]/40 transition-all">
          <div class="text-5xl mb-4">📡</div>
          <h3 class="text-2xl font-bold text-ink mb-3">RSS Feed (Open Source)</h3>
          <p class="text-ink-soft mb-6">La forma más pura y descentralizada de seguir nuestras novedades.</p>
          <a href={'/' + lang + '/rss/'} class="inline-block px-8 py-3 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-all">Ver instrucciones</a>
        </div>
      </div>
    </div>

  </div>
</section>