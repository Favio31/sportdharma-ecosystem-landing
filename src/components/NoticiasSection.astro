---
// Título movido a la sección correcta
import WebPushSubscribe from './WebPushSubscribe.astro';

interface Props { lang: string }
const { lang } = Astro.props;
---

<section id="publicaciones" class="py-20 px-6 bg-surface-alt transition-colors duration-300">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-16">
      <span class="text-[#E8530E] dark:text-orange-500 font-semibold uppercase tracking-wide text-sm">PUBLICACIONES DIARIAS</span>
    <h2 class="text-3xl md:text-4xl font-bold text-white mt-3 mb-4 tracking-wide">MULTI AGENT SWARM FRAMEWORK + IA + HUMANO</h2>


      <p class="text-lg text-ink-soft max-w-5xl mx-auto">
        Búsqueda: MASF | Curación de textos: IA local | Extracción y formato: sportdharma-extractor | Decisión editorial: HUMANO
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- TARJETA PRINCIPAL: PUBLICACIÓN DEL DÍA -->
      <a href="#" class="col-span-1 md:col-span-2 lg:col-span-3 bg-surface border-2 border-[#E8530E] rounded-xl p-6 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.3)] transition-all duration-300 group relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-[#E8530E] text-white text-xs font-bold px-3 py-1 rounded-bl-xl">HOY</div>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-[#E8530E] group-hover:scale-110 transition-transform duration-300 mb-4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <h3 class="text-2xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Publicación del día de hoy</h3>
        <p class="text-base text-ink-soft mb-4">La última publicación y el archivo completo de todos los temas. Tu digest diario modular (MDM).</p>
        <span class="text-[#E8530E] font-bold text-sm group-hover:translate-x-1 transition-transform inline-block">Leer el MDM de hoy →</span>
      </a>
<a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M13 8H7"/><path d="M17 12H7"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Frase del día</h3>
        <p class="text-sm text-ink-soft mb-4">Inspiración diaria para el camino y la mente.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Deporte</h3>
        <p class="text-sm text-ink-soft mb-4">Ciclismo, mecánica, caminata, running, trekking.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 11l5.96 1"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Salud</h3>
        <p class="text-sm text-ink-soft mb-4">Nutrición, recuperación física, salud mental en ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M12 7v14"/><path d="M16 12h2"/><path d="M16 8h2"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/><path d="M6 12h2"/><path d="M6 8h2"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Educación</h3>
        <p class="text-sm text-ink-soft mb-4">Primeros auxilios, supervivencia, habilidades blandas.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Open Source</h3>
        <p class="text-sm text-ink-soft mb-4">Noticias FOSS, grants, herramientas de privacidad.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 12c2.21 0 4 -1.567 4 -3.5s-1.79 -3.5 -4 -3.5c-1.594 0 -2.97 .816 -3.613 2"/><path d="M3.423 14.483a4.944 4.944 0 0 0 -.423 2.017c0 2.485 1.79 4.5 4 4.5s4 -2.015 4 -4.5s-1.79 -4.5 -4 -4.5"/><path d="M14.071 17.01c.327 2.277 1.739 3.99 3.429 3.99c1.933 0 3.5 -2.239 3.5 -5s-1.567 -5 -3.5 -5c-.96 0 -1.868 .606 -2.5 1.5c-.717 1.049 -1.76 1.7 -2.936 1.7c-.92 0 -1.766 -.406 -2.434 -1.087"/><path d="M17 3l2 2"/><path d="M12 3c1.667 3.667 4.667 5.333 9 5"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Espiritualidad</h3>
        <p class="text-sm text-ink-soft mb-4">Tai Chi, yoga, meditación, filosofía de ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M3.5 21 14 3"/><path d="M20.5 21 10 3"/><path d="M15.5 21 12 15l-3.5 6"/><path d="M2 21h20"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Viaje</h3>
        <p class="text-sm text-ink-soft mb-4">Camping, logística, fronteras, finanzas en ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Supervivencia & Primeros Auxilios</h3>
        <p class="text-sm text-ink-soft mb-4">Guías offline para emergencias, botiquín y resolución de problemas en ruta.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
      <a href="#" class="bg-surface border border-line rounded-xl p-6 hover:border-[#E8530E]/40 hover:shadow-[0_0_40px_-8px_rgba(232,83,14,0.2)] transition-all duration-300 group">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 text-slate-400 group-hover:text-[#E8530E] transition-colors duration-300 mb-4"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <h3 class="text-xl font-bold text-ink mb-2 group-hover:text-[#E8530E] transition-colors">Mecánica de Bicicletas</h3>
        <p class="text-sm text-ink-soft mb-4">Reparaciones en ruta, mantenimiento preventivo y herramientas esenciales.</p>
        <span class="text-[#E8530E] font-semibold text-sm group-hover:translate-x-1 transition-transform inline-block">Próximamente →</span>
      </a>
    </div>

    <!-- PORTAL: NOTICIAS E INFORMACIÓN (Notificaciones + RSS) -->
    <div id="notificaciones" class="mt-20 scroll-mt-24">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-3"><span class="text-slate-500 dark:text-slate-400">Activa </span><span class="text-ink">las notificaciones</span></h2>
        <p class="text-ink-soft text-lg max-w-2xl mx-auto">Para recibir nuestras publicaciones diarias activa las:</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start max-w-4xl mx-auto">
        <div class="p-8 rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent hover:border-[#E8530E]/40 transition-all group flex flex-col justify-between h-full">
          <div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 mb-4 text-slate-500 dark:text-slate-400 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            <h3 class="text-2xl font-bold text-ink mb-2">Notificaciones Soberanas</h3>
            <p class="text-ink-soft mb-6"><span class="font-bold text-ink">Privacidad y Transparencia:</span> Al hacer clic, tu navegador genera una clave anónima y segura. Solo recibirás avisos de nuevas publicaciones y podés desactivarlo en cualquier momento desde la configuración de tu dispositivo.</p>
            <div class="flex justify-center"><WebPushSubscribe /></div>
          </div>
        </div>
        <div class="p-8 rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent hover:border-[#E8530E]/40 group transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 mb-4 text-slate-500 dark:text-slate-400 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          <h3 class="text-2xl font-bold text-ink mb-3">RSS Feed (Open Source)</h3>
          <p class="text-ink-soft mb-6">La forma más pura y descentralizada de seguir nuestras novedades.</p>
          <a href={'/' + lang + '/rss/'} class="inline-block px-8 py-3 rounded-lg border border-[#E8530E] text-[#E8530E] font-semibold hover:bg-[#E8530E]/10 transition-all">Ver instrucciones</a>
        </div>
        <div class="md:col-span-2 p-8 rounded-3xl border-2 border-gray-300 dark:border-gray-600 bg-transparent hover:border-[#E8530E]/40 transition-all group flex flex-col items-center text-center h-full">
          <svg viewBox="0 0 380 380" fill="currentColor" class="w-12 h-12 mb-4 text-slate-500 dark:text-slate-400 group-hover:text-[#E8530E] dark:group-hover:text-orange-500 transition-colors" xmlns="http://www.w3.org/2000/svg">
            <path style="fill-rule:evenodd;clip-rule:evenodd;" d="M182.013,68.944c0-0.659-0.057-1.306-0.158-1.936c-0.926,5.649-5.825,9.964-11.737,9.964s-10.811-4.314-11.739-9.964c-0.102,0.63-0.16,1.276-0.16,1.936c0,6.569,5.328,11.897,11.899,11.897C176.688,80.842,182.013,75.514,182.013,68.944z"/><path style="fill-rule:evenodd;clip-rule:evenodd;" d="M209.882,80.842c6.572,0,11.898-5.328,11.898-11.897c0-0.659-0.061-1.306-0.158-1.936c-0.927,5.649-5.828,9.964-11.74,9.964c-5.911,0-10.81-4.314-11.737-9.964c-0.101,0.63-0.157,1.276-0.157,1.936C197.987,75.514,203.314,80.842,209.882,80.842z"/><path style="fill-rule:evenodd;clip-rule:evenodd;" d="M329.905,319.342c0,0-15.82-22.666-55.264-29.025c8.627-7.418,16.863-14.328,24.899-21.48c8.654-7.727,11.936-16.977,8.332-28.564c-9.109-29.152-17.363-45.352-26.965-74.33c-6.992-21.13-21.853-33.203-44.998-33.684c-4.307-0.086-8.872-0.844-12.799-2.506c-1.748-0.739-3.167-1.584-4.278-2.512c-0.038-3.542,0.852-8.541,3.763-15.525c4.902-5.743,8.129-12.717,10.446-19.777c2.109-0.595,4.054-1.781,4.626-2.639c2.231-3,6.363-6.777,7.913-10.275c3.161-7.846,0.297-11.859-1.19-13.049c-1.459-1.215-3.044-1.32-4.617-0.816c0.437-1.481,0.898-2.95,1.444-4.398c5.604-14.83-1.742-29.617-16.232-36.921c-5.038-2.54-9.665-4.217-13.92-5.341C209.89,8.093,200.91,0,190.001,0c-10.91,0-19.892,8.093-21.067,18.498c-4.255,1.124-8.882,2.801-13.921,5.341c-14.488,7.304-21.834,22.091-16.231,36.921c0.546,1.448,1.009,2.918,1.445,4.4c-1.573-0.506-3.158-0.402-4.617,0.814c-1.488,1.189-4.352,5.203-1.191,13.049c1.548,3.498,5.682,7.275,7.915,10.275c0.57,0.858,2.516,2.043,4.624,2.639c2.132,6.495,5.034,12.919,9.302,18.379c0,0,4.287,8.332,6.622,15.096c-1.174,1.665-3.155,3.14-5.993,4.34c-3.927,1.662-8.492,2.42-12.799,2.506c-23.144,0.48-38.006,12.554-44.998,33.684c-9.602,28.979-17.855,45.178-26.965,74.33c-3.604,11.588-0.322,20.838,8.332,28.564c8.036,7.152,16.272,14.063,24.899,21.48c-39.443,6.359-55.264,29.025-55.264,29.025C39.708,331.147,18.273,380,95.623,380h188.754C361.727,380,340.292,331.147,32